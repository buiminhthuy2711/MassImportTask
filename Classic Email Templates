<!DOCTYPE html>
<html>
  <head>
    <style type="text/css">
        .import-body {
            font-family:
            "Salesforce Sans", "Meiryo", "Yu Gothic", "Hiragino Kaku Gothic ProN",
            sans-serif;
            font-size: 0.88rem;
            color: #333;
        }

        .import-header {
            background-color: #2baf6a;
            color: #fff;
            padding: 1rem;
            text-align: center;
        }

        .import-header h1 {
            margin: 0;
            font-size: 1.5rem;
        }

        .import-summary {
            margin: 1rem 0;
            padding: 1rem;
            border: 1px solid #e0e0e0;
            background-color: #e6f7ee;
        }

        .import-summary h2 {
            margin-top: 0;
            font-size: 1.2rem;
            color: #1a7a47;
        }

        .project-link, .tasks-link {
            color: #239b5b;
            text-decoration: none;
        }
    </style>
  </head>
  <body>
    <div class="import-body">
