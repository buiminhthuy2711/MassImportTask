<apex:page controller="JIP_CandidateManagementController" lightningStylesheets="true" docType="html-5.0" showHeader="false">
    <apex:slds />

    <style>
        :root {
            --primary: #0176d3;
            --primary-dark: #014486;
            --danger: #ea001e;
            --danger-dark: #ba0517;
            --success: #2e844a;
            --bg: #f3f3f3;
            --white: #ffffff;
            --text: #181818;
            --text-light: #444444;
            --border: #dddbda;
            --shadow: 0 2px 8px rgba(0,0,0,0.10);
            --orange: #e87600;
            --purple: #9050e9;
        }
        .jipa-container {
            max-width: 1300px;
            margin: 2rem auto;
            font-family: 'Salesforce Sans', 'Meiryo', 'Yu Gothic', sans-serif;
            background: var(--bg);
            min-height: 80vh;
        }
        .jipa-header {
            background: linear-gradient(135deg, #9050e9, #032d60);
            color: var(--white);
            padding: 1.5rem 2rem;
            border-radius: 8px 8px 0 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .jipa-header h1 { font-size: 1.5rem; margin: 0; font-weight: 700; }
        .jipa-header .subtitle { font-size: 0.9rem; opacity: 0.85; margin-top: 0.25rem; }
        .jipa-body {
            padding: 1.5rem 2rem 2rem;
            background: var(--white);
            border-radius: 0 0 8px 8px;
            box-shadow: var(--shadow);
        }
        .jipa-toolbar {
            display: flex; align-items: center; gap: 0.75rem;
            margin-bottom: 1.25rem; flex-wrap: wrap;
        }
        .jipa-toolbar input[type="text"] {
            padding: 0.5rem 0.85rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.95rem; width: 240px; outline: none;
        }
        .jipa-toolbar input[type="text"]:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.15);
        }
        .jipa-toolbar select {
            padding: 0.5rem 0.65rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.9rem; outline: none;
        }
        .jipa-toolbar select:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.15);
        }
        .btn {
            padding: 0.5rem 1.2rem; border: none; border-radius: 6px;
            font-size: 0.92rem; cursor: pointer; font-weight: 600;
            transition: background 0.15s; display: inline-flex; align-items: center; gap: 0.35rem;
        }
        .btn-primary { background: var(--primary); color: var(--white); }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-secondary { background: #e5e5e5; color: var(--text); }
        .btn-secondary:hover { background: #d4d4d4; }
        .btn-danger { background: var(--danger); color: var(--white); }
        .btn-danger:hover { background: var(--danger-dark); }
        .btn-success { background: var(--success); color: var(--white); }
        .btn-success:hover { background: #236b3b; }
        .btn-sm { padding: 0.32rem 0.75rem; font-size: 0.84rem; }
        .btn-new { margin-left: auto; }

        /* Table */
        .jipa-table-wrap { overflow-x: auto; }
        .jipa-table {
            width: 100%; border-collapse: separate; border-spacing: 0;
            border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
            min-width: 1050px;
        }
        .jipa-table thead th {
            background: #f7f7f7; color: var(--text); font-weight: 700;
            padding: 0.65rem 0.75rem; text-align: left; font-size: 0.85rem;
            border-bottom: 2px solid var(--border); white-space: nowrap;
        }
        .jipa-table tbody td {
            padding: 0.55rem 0.75rem; border-bottom: 1px solid #f0f0f0;
            font-size: 0.88rem; color: var(--text-light); white-space: nowrap;
        }
        .jipa-table tbody tr:hover { background: #f0f7ff; }
        .jipa-table tbody tr:last-child td { border-bottom: none; }
        .jipa-table .actions { display: flex; gap: 0.35rem; }
        .jipa-empty { text-align: center; color: #999; padding: 2.5rem 0; font-size: 1.05rem; }
        .jipa-count { color: var(--text-light); font-size: 0.88rem; margin-bottom: 0.6rem; }

        /* Status badges */
        .badge {
            padding: 0.2rem 0.55rem; border-radius: 10px; font-size: 0.78rem;
            font-weight: 600; display: inline-block;
        }
        .badge-active { background: #e6f9ed; color: #2e844a; }
        .badge-inactive { background: #ffeaea; color: #ea001e; }
        .badge-new { background: #eef4ff; color: #0176d3; }
        .badge-applied { background: #e6f9ed; color: #2e844a; }
        .badge-screening { background: #fff3cd; color: #856404; }
        .badge-interview { background: #e8daff; color: #9050e9; }
        .badge-offer { background: #ffead5; color: #e87600; }
        .badge-hired { background: #d4edda; color: #155724; }
        .badge-rejected { background: #ffeaea; color: #ea001e; }

        /* Modal */
        .jipa-modal-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.45); z-index: 9000;
            display: flex; align-items: flex-start; justify-content: center;
            padding-top: 3vh; overflow-y: auto;
        }
        .jipa-modal {
            background: var(--white); border-radius: 10px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
            width: 720px; max-width: 95vw;
            margin-bottom: 3vh;
            animation: fadeInModal 0.18s;
        }
        @keyframes fadeInModal {
            from { opacity: 0; transform: translateY(-16px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .jipa-modal-header {
            background: linear-gradient(135deg, #9050e9, #032d60);
            color: var(--white); padding: 1.1rem 1.5rem;
            border-radius: 10px 10px 0 0; font-size: 1.12rem; font-weight: 700;
        }
        .jipa-modal-body { padding: 1.2rem 1.5rem 0.5rem; }
        .section-title {
            font-size: 0.95rem; font-weight: 700; color: var(--purple);
            border-bottom: 2px solid var(--purple); padding-bottom: 0.35rem;
            margin: 1.2rem 0 0.8rem; display: flex; align-items: center; gap: 0.4rem;
        }
        .section-title:first-child { margin-top: 0; }
        .form-row { display: flex; gap: 1rem; margin-bottom: 0.85rem; }
        .form-group { flex: 1; min-width: 0; }
        .form-group label {
            display: block; font-weight: 600; margin-bottom: 0.25rem;
            color: var(--text); font-size: 0.88rem;
        }
        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="tel"],
        .form-group input[type="date"],
        .form-group input[type="number"],
        .form-group select,
        .form-group textarea {
            width: 100%; padding: 0.45rem 0.65rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.9rem; box-sizing: border-box; outline: none;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.12);
        }
        .form-group textarea { resize: vertical; min-height: 60px; }
        .required-mark { color: #ea001e; }
        .jipa-modal-footer {
            display: flex; justify-content: flex-end; gap: 0.6rem;
            padding: 1rem 1.5rem; border-top: 1px solid var(--border);
        }
        .jipa-messages { margin-bottom: 1rem; }
        .filter-label { font-size: 0.82rem; color: var(--text-light); font-weight: 600; }
    </style>

    <apex:form id="mainForm">
        <div class="jipa-container">
            <!-- Header -->
            <div class="jipa-header">
                <div>
                    <h1>&#128101; 候補者管理システム</h1>
                    <div class="subtitle">Candidate Management - 候補者情報の一覧・登録・編集・削除</div>
                </div>
            </div>

            <div class="jipa-body">
                <!-- Messages -->
                <div class="jipa-messages">
                    <apex:messages id="pageMessages" layout="list" />
                </div>

                <!-- Toolbar -->
                <div class="jipa-toolbar">
                    <apex:inputText value="{!searchKeyword}" html-placeholder="名前・メール・所在地で検索..." />
                    <span class="filter-label">ステージ:</span>
                    <apex:selectList value="{!filterPipeline}" size="1">
                        <apex:selectOptions value="{!pipelineOptions}" />
                    </apex:selectList>
                    <span class="filter-label">ステータス:</span>
                    <apex:selectList value="{!filterStatus}" size="1">
                        <apex:selectOptions value="{!statusOptions}" />
                    </apex:selectList>
                    <apex:commandButton value="&#128269; 検索" action="{!searchCandidates}" reRender="mainForm" styleClass="btn btn-primary" />
                    <apex:commandButton value="クリア" action="{!clearSearch}" reRender="mainForm" styleClass="btn btn-secondary" />
                    <apex:commandButton value="&#10133; 新規登録" action="{!openNewModal}" reRender="mainForm" styleClass="btn btn-success btn-new" />
                </div>

                <!-- Count -->
                <div class="jipa-count">
                    検索結果: <strong>{!candidates.size}</strong> 件
                </div>

                <!-- Data Table -->
                <apex:outputPanel rendered="{!candidates.size > 0}">
                    <div class="jipa-table-wrap">
                        <table class="jipa-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>候補者ID</th>
                                    <th>氏名</th>
                                    <th>メール</th>
                                    <th>国籍</th>
                                    <th>採用ステージ</th>
                                    <th>ステータス</th>
                                    <th>日本語</th>
                                    <th>勤務形態</th>
                                    <th>稼働可能日</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <apex:variable var="rowNum" value="{!0}" />
                                <apex:repeat value="{!candidates}" var="c">
                                    <apex:variable var="rowNum" value="{!rowNum + 1}" />
                                    <tr>
                                        <td>{!rowNum}</td>
                                        <td><strong>{!c.Name}</strong></td>
                                        <td>{!c.Full_name__c}</td>
                                        <td>{!c.Email__c}</td>
                                        <td>{!c.Nationality__c}</td>
                                        <td>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'New'}">
                                                <span class="badge badge-new">New</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Applied'}">
                                                <span class="badge badge-applied">Applied</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Screening'}">
                                                <span class="badge badge-screening">Screening</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Interview'}">
                                                <span class="badge badge-interview">Interview</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Offer'}">
                                                <span class="badge badge-offer">Offer</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Hired'}">
                                                <span class="badge badge-hired">Hired</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.PipelineStatus__c == 'Rejected'}">
                                                <span class="badge badge-rejected">Rejected</span>
                                            </apex:outputPanel>
                                        </td>
                                        <td>
                                            <apex:outputPanel rendered="{!c.CurrentStatus__c == 'Active'}">
                                                <span class="badge badge-active">Active</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.CurrentStatus__c == 'Inactive'}">
                                                <span class="badge badge-inactive">Inactive</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!c.CurrentStatus__c == 'None' || c.CurrentStatus__c == null || c.CurrentStatus__c == ''}">
                                                <span class="badge">—</span>
                                            </apex:outputPanel>
                                        </td>
                                        <td>{!c.JapaneseLevel__c}</td>
                                        <td>{!c.Work_Style__c}</td>
                                        <td>
                                            <apex:outputText value="{0,date,yyyy/MM/dd}">
                                                <apex:param value="{!c.AvailabilityDate__c}" />
                                            </apex:outputText>
                                        </td>
                                        <td class="actions">
                                            <apex:commandButton value="&#9998; 編集" action="{!openEditModal}" reRender="mainForm" styleClass="btn btn-primary btn-sm">
                                                <apex:param name="editId" value="{!c.Id}" assignTo="{!currentCandidate}" />
                                            </apex:commandButton>
                                            <apex:commandButton value="&#128465; 削除" action="{!deleteCandidate}" reRender="mainForm" styleClass="btn btn-danger btn-sm"
                                                onclick="if(!confirm('この候補者を削除してもよろしいですか？')){return false;}">
                                                <apex:param name="deleteId" value="{!c.Id}" assignTo="{!deleteCandidateId}" />
                                            </apex:commandButton>
                                        </td>
                                    </tr>
                                </apex:repeat>
                            </tbody>
                        </table>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!candidates.size == 0}">
                    <div class="jipa-empty">
                        候補者データがありません。「新規登録」ボタンから候補者を追加してください。
                    </div>
                </apex:outputPanel>
            </div>
        </div>

        <!-- Modal: New / Edit -->
        <apex:outputPanel rendered="{!showModal}">
            <div class="jipa-modal-overlay">
                <div class="jipa-modal">
                    <div class="jipa-modal-header">
                        <apex:outputPanel rendered="{!!isEditMode}">&#10133; 新規候補者登録</apex:outputPanel>
                        <apex:outputPanel rendered="{!isEditMode}">&#9998; 候補者情報編集</apex:outputPanel>
                    </div>
                    <div class="jipa-modal-body">

                        <!-- Section: 基本情報 -->
                        <div class="section-title">&#128203; 基本情報</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>氏名 (Full Name) <span class="required-mark">*</span></label>
                                <apex:inputText value="{!currentCandidate.Full_name__c}" html-placeholder="例: Nguyen Van A" />
                            </div>
                            <div class="form-group">
                                <label>国籍</label>
                                <apex:inputField value="{!currentCandidate.Nationality__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>メールアドレス <span class="required-mark">*</span></label>
                                <apex:inputField value="{!currentCandidate.Email__c}" />
                            </div>
                            <div class="form-group">
                                <label>電話番号</label>
                                <apex:inputField value="{!currentCandidate.Phone__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>所在地</label>
                                <apex:inputText value="{!currentCandidate.Location__c}" html-placeholder="例: 東京都" />
                            </div>
                            <div class="form-group">
                                <label>ソース</label>
                                <apex:inputField value="{!currentCandidate.Source__c}" />
                            </div>
                        </div>

                        <!-- Section: ステータス -->
                        <div class="section-title">&#128200; ステータス・採用情報</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>アクティブステータス <span class="required-mark">*</span></label>
                                <apex:inputField value="{!currentCandidate.CurrentStatus__c}" />
                            </div>
                            <div class="form-group">
                                <label>採用ステージ <span class="required-mark">*</span></label>
                                <apex:inputField value="{!currentCandidate.PipelineStatus__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>勤務形態</label>
                                <apex:inputField value="{!currentCandidate.Work_Style__c}" />
                            </div>
                            <div class="form-group">
                                <label>希望単価</label>
                                <apex:inputField value="{!currentCandidate.ExpectedRate__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>稼働可能日</label>
                                <apex:inputField value="{!currentCandidate.AvailabilityDate__c}" />
                            </div>
                            <div class="form-group"></div>
                        </div>

                        <!-- Section: 語学スキル -->
                        <div class="section-title">&#127760; 語学スキル</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>日本語レベル</label>
                                <apex:inputField value="{!currentCandidate.JapaneseLevel__c}" />
                            </div>
                            <div class="form-group">
                                <label>日本語会話力 (1-5)</label>
                                <apex:inputField value="{!currentCandidate.JapaneseConversation__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>英語レベル</label>
                                <apex:inputField value="{!currentCandidate.EngLishLevel__c}" />
                            </div>
                            <div class="form-group"></div>
                        </div>

                        <!-- Section: ビザ情報 -->
                        <div class="section-title">&#128196; ビザ情報</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>ビザステータス</label>
                                <apex:inputField value="{!currentCandidate.VisaStatus__c}" />
                            </div>
                            <div class="form-group">
                                <label>ビザ有効期限</label>
                                <apex:inputField value="{!currentCandidate.VisaExpiry__c}" />
                            </div>
                        </div>

                    </div>
                    <div class="jipa-modal-footer">
                        <apex:commandButton value="キャンセル" action="{!closeModal}" reRender="mainForm" styleClass="btn btn-secondary" />
                        <apex:commandButton value="{!IF(isEditMode, '&#9998; 更新する', '&#10133; 登録する')}" action="{!saveCandidate}" reRender="mainForm" styleClass="btn btn-primary" />
                    </div>
                </div>
            </div>
        </apex:outputPanel>
    </apex:form>
</apex:page>