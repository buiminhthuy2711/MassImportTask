                          <apex:param name="taskId"
                            value="{!tsk.Id}"
                            assignTo="{!deleteTaskId}"
                          />
                        </apex:commandButton>
                        <apex:commandButton value="&#x2716;"
                          action="{!deleteTask}"
                          reRender="mainForm"
                          styleClass="icon-btn"
                          style="
                            background: transparent;
                            border: none;
                            cursor: pointer;
                            font-size: 0.85rem;
                            color: #d32f2f;
                          "
                          onclick="
