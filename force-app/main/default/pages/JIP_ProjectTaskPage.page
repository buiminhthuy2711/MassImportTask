                    <!-- Subject -->
                    <td data-col="col-subject" class="td-subject">
                      <a
                        href="{!$Page.JIP_ProjectTaskDetailPage}?id={!tsk.Id}"
                        style="color: var(--text); text-decoration: none"
                        >{!tsk.Subject__c}</a
                      >
                    </td>
                    <!-- Assignee -->
                    <td data-col="col-assignee">
                      <apex:outputPanel rendered="{!tsk.Assignee__c != null}">
                        <span class="assignee-badge">
                          <span class="assignee-avatar">
                            {!LEFT(IF(tsk.Assignee__r.LastName__c != null,
                            tsk.Assignee__r.LastName__c, tsk.Assignee__r.Name),
                            1)}
                          </span>
                          <span>
                            {!IF(tsk.Assignee__r.LastName__c != null,
                            tsk.Assignee__r.LastName__c, '')}
                            {!IF(tsk.Assignee__r.FirstName__c != null, ' ' +
                            tsk.Assignee__r.FirstName__c, '')}
                          </span>
