  <script>
    // ===== Column Visibility =====
    var STORAGE_KEY = "jip_task_columns";
    var defaultColumns = {
      "col-type": true,
      "col-key": true,
      "col-subject": true,
      "col-assignee": true,
      "col-status": true,
      "col-category": true,
      "col-priority": true,
      "col-milestone": true,
      "col-created": true,
      "col-start": false,
      "col-due": true,
      "col-estimated": false,
      "col-actual": false,
      "col-updated": false,
      "col-registered": false,
      "col-actions": true
    };

    function getColumnSettings() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          return JSON.parse(saved);
        }
      } catch (e) {}
      return defaultColumns;
    }

    function saveColumnSettings(settings) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
      } catch (e) {}
    }

    function toggleColumn(colId, visible) {
      var settings = getColumnSettings();
      settings[colId] = visible;
      saveColumnSettings(settings);
      applyColumnVisibility();
    }

    function applyColumnVisibility() {
      var settings = getColumnSettings();
      for (var colId in settings) {
        var visible = settings[colId];
        var elements = document.querySelectorAll('[data-col="' + colId + '"]');
        elements.forEach(function (el) {
          el.style.display = visible ? "" : "none";
        });
        // Update checkbox
        var checkbox = document.querySelector(
          '.column-dropdown input[data-col="' + colId + '"]'
        );
        if (checkbox) {
          checkbox.checked = visible;
        }
      }
    }

    function resetColumns() {
      saveColumnSettings(defaultColumns);
      applyColumnVisibility();
    }

    function toggleColumnDropdown(e) {
      e.preventDefault();
      e.stopPropagation();
      var dropdown = document.getElementById("columnDropdown");
      dropdown.classList.toggle("show");
    }

    function closeColumnDropdown() {
      var dropdown = document.getElementById("columnDropdown");
      dropdown.classList.remove("show");
    }

    // Close dropdown when clicking outside
    document.addEventListener("click", function (e) {
      var dropdown = document.getElementById("columnDropdown");
      var btn = document.querySelector(".btn-column-selector");
      if (dropdown && !dropdown.contains(e.target) && !btn.contains(e.target)) {
        dropdown.classList.remove("show");
      }
    });

    // ===== Column Resizing =====
    function initColumnResizing() {
      var table = document.getElementById("taskTable");
      if (!table) return;

      var resizers = table.querySelectorAll(".resizer");
      var currentResizer;
      var startX, startWidth;

      resizers.forEach(function (resizer) {
        resizer.addEventListener("mousedown", function (e) {
          e.preventDefault();
          e.stopPropagation();
          currentResizer = resizer;
          var th = resizer.parentElement;
          startX = e.pageX;
          startWidth = th.offsetWidth;
          resizer.classList.add("resizing");
          document.addEventListener("mousemove", onMouseMove);
          document.addEventListener("mouseup", onMouseUp);
        });
      });

      function onMouseMove(e) {
        if (!currentResizer) return;
        var th = currentResizer.parentElement;
        var diff = e.pageX - startX;
        var newWidth = Math.max(50, startWidth + diff);
        th.style.width = newWidth + "px";
      }

      function onMouseUp() {
        if (currentResizer) {
          currentResizer.classList.remove("resizing");
          currentResizer = null;
        }
        document.removeEventListener("mousemove", onMouseMove);
        document.removeEventListener("mouseup", onMouseUp);
      }
    }

    // ===== Column Reordering (Drag & Drop) =====
    var ORDER_STORAGE_KEY = "jip_task_column_order";
    var defaultColumnOrder = [
      "col-type",
      "col-key",
      "col-subject",
      "col-assignee",
      "col-status",
      "col-category",
      "col-priority",
      "col-milestone",
      "col-created",
      "col-start",
      "col-due",
      "col-estimated",
      "col-actual",
      "col-updated",
      "col-registered",
      "col-actions"
    ];

    function getColumnOrder() {
      try {
        var saved = localStorage.getItem(ORDER_STORAGE_KEY);
        if (saved) {
          return JSON.parse(saved);
        }
      } catch (e) {}
      return defaultColumnOrder.slice();
    }

    function saveColumnOrder(order) {
      try {
        localStorage.setItem(ORDER_STORAGE_KEY, JSON.stringify(order));
      } catch (e) {}
    }

    function applyColumnOrder() {
      var table = document.getElementById("taskTable");
      if (!table) return;

      var order = getColumnOrder();
      var thead = table.querySelector("thead tr");
      var tbody = table.querySelector("tbody");
      if (!thead) return;

      // Reorder header cells
      var thCells = {};
      thead.querySelectorAll("th[data-col]").forEach(function (th) {
        thCells[th.getAttribute("data-col")] = th;
      });

      order.forEach(function (colId) {
        if (thCells[colId]) {
          thead.appendChild(thCells[colId]);
        }
      });

      // Reorder body cells for each row
      if (tbody) {
        tbody.querySelectorAll("tr").forEach(function (row) {
          var tdCells = {};
          row.querySelectorAll("td[data-col]").forEach(function (td) {
            tdCells[td.getAttribute("data-col")] = td;
          });

          order.forEach(function (colId) {
            if (tdCells[colId]) {
              row.appendChild(tdCells[colId]);
            }
          });
        });
      }
    }

    function initColumnDragDrop() {
      var table = document.getElementById("taskTable");
      if (!table) return;

      var draggedCol = null;

      table
        .querySelectorAll('thead th[draggable="true"]')
        .forEach(function (th) {
          th.addEventListener("dragstart", function (e) {
            draggedCol = th.getAttribute("data-col");
            th.classList.add("dragging");
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", draggedCol);
          });

          th.addEventListener("dragend", function () {
            th.classList.remove("dragging");
            table.querySelectorAll("thead th").forEach(function (cell) {
              cell.classList.remove("drag-over");
            });
            draggedCol = null;
          });

          th.addEventListener("dragover", function (e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
            var targetCol = th.getAttribute("data-col");
            if (targetCol !== draggedCol && targetCol !== "col-actions") {
              th.classList.add("drag-over");
            }
          });

          th.addEventListener("dragleave", function () {
            th.classList.remove("drag-over");
          });

          th.addEventListener("drop", function (e) {
            e.preventDefault();
            th.classList.remove("drag-over");
            var targetCol = th.getAttribute("data-col");
            if (
              !draggedCol ||
              draggedCol === targetCol ||
              targetCol === "col-actions"
            )
              return;

            var order = getColumnOrder();
            var fromIdx = order.indexOf(draggedCol);
            var toIdx = order.indexOf(targetCol);

            if (fromIdx > -1 && toIdx > -1) {
              order.splice(fromIdx, 1);
              order.splice(toIdx, 0, draggedCol);
              saveColumnOrder(order);
              applyColumnOrder();
              initColumnResizing();
              initColumnDragDrop();
            }
          });
        });
    }

    function resetColumnOrder() {
      saveColumnOrder(defaultColumnOrder.slice());
      applyColumnOrder();
      initColumnResizing();
      initColumnDragDrop();
    }

    function resetAllColumns() {
      // Reset both visibility and order
      saveColumnSettings(defaultColumns);
      saveColumnOrder(defaultColumnOrder.slice());
      applyColumnOrder();
      applyColumnVisibility();
      initColumnResizing();
      initColumnDragDrop();
    }

    // Initialize on page load
    document.addEventListener("DOMContentLoaded", function () {
      applyColumnOrder();
      applyColumnVisibility();
      initColumnResizing();
      initColumnDragDrop();
    });

    // Re-initialize after Visualforce rerender
    if (typeof Visualforce !== "undefined") {
      Visualforce.remoting.Manager.invokeAction = (function (original) {
        return function () {
          var result = original.apply(this, arguments);
          setTimeout(function () {
            applyColumnOrder();
            applyColumnVisibility();
            initColumnResizing();
            initColumnDragDrop();
          }, 100);
          return result;
        };
      })(Visualforce.remoting.Manager.invokeAction);
    }
  </script>

  <!-- Mass import Thắng -->
  <script>
    let selectedCsvFile = null;
    function validateCsvFile() {
      const fileInput = document.getElementById(
        '{!$Component.mainForm.csvFileInput}'
    );
    const errorElement = document.getElementById('fileError');
    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
      errorElement.textContent = 'Please select a CSV file.';
      errorElement.style.display = 'block';
      return false;
    }
    return true;
  }
  function handleCsvFile(input) {
    const fileNameElement =
    document.getElementById('selectedFileName');
    const errorElement =
    document.getElementById('fileError');

    errorElement.style.display = 'none';
    errorElement.textContent = '';
    if (!input.files || input.files.length === 0) {
      selectedCsvFile = null;
      fileNameElement.textContent = 'No file selected';
      return;
    }
    const file = input.files[0];
    if (!file.name.toLowerCase().endsWith('.csv')) {
      selectedCsvFile = null;
      fileNameElement.textContent = 'No file selected';
      errorElement.textContent =
       'Please select a CSV file.';
      errorElement.style.display = 'block';
      input.value = '';
      return;
    }
    selectedCsvFile = file;
    fileNameElement.textContent = file.name;
  }
  </script>

</apex:page>