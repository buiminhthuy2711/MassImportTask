                              return false;
                            }
                          "
                        >
                          <apex:param name="delId"
                            value="{!tsk.Id}"
                            assignTo="{!deleteTaskId}"
                          />
                        </apex:commandButton>
                      </div>
                    </td>
                  </tr>
                </apex:repeat>
              </tbody>
            </table>
          </apex:outputPanel>

          <apex:outputPanel rendered="{!taskCount == 0}">
            <div class="empty-msg">{!T['no_tasks']} {!T['no_tasks_hint']}</div>
          </apex:outputPanel>
        </div>

        <!-- Bottom info -->
        <apex:outputPanel rendered="{!taskCount > 0}">
          <div class="info-bar" style="border-top: 1px solid var(--border)">
            <span>
              {!countAll} {!T['items']} ({!taskCount})
