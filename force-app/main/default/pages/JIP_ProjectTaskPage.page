                            style="background: #888"
                          >
                            {!LEFT(tsk.RegisteredBy__c, 1)}
                          </span>
                          <span>{!tsk.RegisteredBy__c}</span>
                        </span>
                      </apex:outputPanel>
                    </td>
                    <!-- Actions -->
                    <td data-col="col-actions">
                      <div class="td-actions">
                        <apex:commandButton value="&#x270E;"
                          action="{!editTask}"
                          reRender="mainForm"
                          styleClass="icon-btn"
                          style="
                            background: transparent;
                            border: none;
                            cursor: pointer;
                            font-size: 0.9rem;
                          "
