                      <apex:outputText value="{0,date,yyyy/MM/dd}">
                        <apex:param value="{!tsk.CreatedDate}" />
                      </apex:outputText>
                    </td>
                    <!-- Start Date -->
                    <td data-col="col-start" style="display: none">
                      <apex:outputText value="{0,date,yyyy/MM/dd}"
                        rendered="{!tsk.StartDate__c != null}"
                      >
                        <apex:param value="{!tsk.StartDate__c}" />
                      </apex:outputText>
                    </td>
                    <!-- Due Date -->
                    <td data-col="col-due">
                      <apex:outputText value="{0,date,yyyy/MM/dd}"
                        rendered="{!tsk.DueDate__c != null}"
