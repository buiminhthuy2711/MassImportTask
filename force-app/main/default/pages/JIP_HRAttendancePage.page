                    action="{!checkIn}"
                    styleClass="punch-btn check-in"
                    rerender="mainForm"
                    onclick="setDeviceInfo()"
                    disabled="{!isCheckedIn}"
                  />
                  <apex:commandButton value="{!T['check_out']}"
                    action="{!checkOut}"
                    styleClass="punch-btn check-out"
                    rerender="mainForm"
                    onclick="setDeviceInfo()"
                    disabled="{!NOT(isCheckedIn)}"
                  />
                </div>
                <script>
                  function setDeviceInfo() {
                    // Set device type synchronously
                    var device = /Mobi|Android/i.test(navigator.userAgent)
                      ? "Smartphone"
                      : "PC";
                    var gpsEl = document.getElementById(
                      "{!$Component.gpsLocation}"
                    );
                    var ipEl = document.getElementById(
                      "{!$Component.ipAddress}"
                    );
                    var deviceEl = document.getElementById(
                      "{!$Component.deviceType}"
                    );

                    if (deviceEl) deviceEl.value = device;
                    if (gpsEl) gpsEl.value = "";
                    if (ipEl) ipEl.value = "";

                    // Try to get GPS (async but non-blocking)
                    if (navigator.geolocation && gpsEl) {
                      navigator.geolocation.getCurrentPosition(
                        function (pos) {
                          gpsEl.value =
                            pos.coords.latitude + "," + pos.coords.longitude;
                        },
                        function () {}
                      );
                    }

                    // Try to get IP (async but non-blocking)
                    if (ipEl) {
                      fetch("https://api.ipify.org?format=json")
                        .then(function (r) {
                          return r.json();
                        })
                        .then(function (data) {
                          ipEl.value = data.ip;
                        })
                        .catch(function () {});
                    }

                    return true;
                  }
                </script>
