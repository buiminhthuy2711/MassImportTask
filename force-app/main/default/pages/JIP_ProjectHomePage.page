<apex:page controller="JIP_ProjectHomeController"
  lightningStylesheets="true"
  docType="html-5.0"
>
  <apex:slds />
  <apex:includeLightning />

  <style>
    :root {
      --green: #2baf6a;
      --green-dark: #239b5b;
      --green-darker: #1a7a47;
      --green-light: #e6f7ee;
      --orange: #e8833a;
      --red: #d9534f;
      --blue: #5b9bd5;
      --gray: #888;
      --bg: #f5f5f5;
      --white: #ffffff;
      --text: #333;
      --text-light: #666;
      --border: #e0e0e0;
    }
    * {
      box-sizing: border-box;
    }
    .ph-wrap {
      display: flex;
      min-height: 100vh;
      font-family:
        "Salesforce Sans", "Meiryo", "Yu Gothic", "Hiragino Kaku Gothic ProN",
        sans-serif;
      font-size: 0.88rem;
      color: var(--text);
    }

    /* ===== MAIN AREA ===== */
    .main-area {
      flex: 1;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Header */
    .ph-header {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 0.8rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .ph-header-left {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .ph-header-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .ph-header-title .rss-icon {
      font-size: 0.85rem;
      color: var(--orange);
      cursor: pointer;
    }
    .ph-header-right {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
    .filter-label {
      font-size: 0.85rem;
      color: var(--text-light);
    }
    .filter-select {
      padding: 0.3rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 0.85rem;
      background: var(--white);
    }
    .btn-display-settings {
      padding: 0.35rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--white);
      font-size: 0.82rem;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .btn-display-settings:hover {
      background: #f8f8f8;
    }
    .settings-icon {
      font-size: 0.9rem;
      color: var(--text-light);
    }

    /* Feed content */
    .ph-content {
      flex: 1;
      overflow-y: auto;
      padding: 1.2rem 1.5rem;
    }

    @media (max-width: 700px) {
      .ph-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
    }
  </style>

  <apex:form id="mainForm">
    <div class="ph-wrap">
      <!-- LEFT SIDEBAR -->
      <c:JIP_ProjectSidebar projectId="{!selectedProjectId}"
        projectName="{!projectName}"
        activePage="home"
      />

      <!-- MAIN AREA -->
      <div class="main-area">
        <!-- Header -->
        <div class="ph-header">
          <div class="ph-header-left">
            <div class="ph-header-title">{!T['project_home']}</div>
          </div>
          <div class="ph-header-right">
            <span class="btn-display-settings">
              <span class="settings-icon">&#x2261;</span>
              {!T['display_settings']}
            </span>
          </div>
        </div>

        <!-- Dashboard -->
        <div id="dashboard-container" style="padding: 1.2rem 1.5rem 0"></div>

        <!-- Main content area (placeholder for future use) -->
        <div class="ph-content"></div>
      </div>
    </div>
  </apex:form>

  <script>
    $Lightning.use("c:JIP_ProjectDashboardOutApp", function () {
      $Lightning.createComponent(
        "c:jipProjectDashboard",
        {},
        "dashboard-container",
        function (cmp) {
          console.log("Dashboard component created");
        }
      );
    });
  </script>
</apex:page>