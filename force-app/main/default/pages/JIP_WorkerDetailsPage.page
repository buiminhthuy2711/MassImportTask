<apex:page controller="JIP_WorkerDetailsController"
  lightningStylesheets="true"
  docType="html-5.0"
  showHeader="false"
>
  <apex:slds />

  <style>
    :root {
      --primary: #2c5282;
      --primary-dark: #1a365d;
      --primary-light: #4299e1;
      --danger: #e53e3e;
      --danger-dark: #c53030;
      --success: #38a169;
      --success-dark: #2f855a;
      --warning: #d69e2e;
      --bg: #f7fafc;
      --white: #ffffff;
      --text: #2d3748;
      --text-light: #718096;
      --border: #e2e8f0;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      --purple: #805ad5;
    }
    * {
      box-sizing: border-box;
    }

    /* Main Layout */
    .details-wrap {
      display: flex;
      min-height: 100vh;
      font-family:
        "Salesforce Sans", "Meiryo", "Yu Gothic", "Hiragino Kaku Gothic ProN",
        sans-serif;
      font-size: 0.88rem;
      color: var(--text);
    }

    /* Main Content Area */
    .details-main {
      flex: 1;
      background: var(--bg);
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    /* Top Bar */
    .top-bar {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.82rem;
    }
    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .top-bar-left .nav-link {
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .top-bar-left .nav-link:hover {
      color: var(--primary);
    }
    .top-bar-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .top-bar-actions .edit-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .top-bar-actions .icon-btn {
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--white);
      color: var(--text-light);
      cursor: pointer;
      font-size: 0.85rem;
    }
    .top-bar-actions .icon-btn:hover {
      background: var(--bg);
    }
    .top-bar-actions .btn-edit {
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--primary);
      border-radius: 4px;
      background: var(--primary);
      color: var(--white);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .top-bar-actions .btn-edit:hover {
      background: #1557a0;
      border-color: #1557a0;
    }
    .top-bar-actions .btn-cancel {
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--white);
      color: var(--text);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .top-bar-actions .btn-cancel:hover {
      background: var(--bg);
    }

    /* Employee Header */
    .emp-header {
      background: var(--white);
      padding: 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      gap: 1.5rem;
    }
    .emp-avatar-large {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 2rem;
      font-weight: 700;
      flex-shrink: 0;
      overflow: hidden;
    }
    .emp-avatar-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .avatar-trigger {
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;
    }
    .avatar-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 1rem;
    }
    .avatar-modal.open {
      display: flex;
    }
    .avatar-modal-card {
      width: 100%;
      max-width: 420px;
      background: var(--white);
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
      overflow: hidden;
    }
    .avatar-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .avatar-modal-title {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
    }
    .avatar-modal-close {
      border: none;
      background: transparent;
      color: var(--text-light);
      font-size: 1.2rem;
      cursor: pointer;
      line-height: 1;
    }
    .avatar-modal-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      align-items: center;
    }
    .avatar-preview-large {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border);
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 2.2rem;
      font-weight: 700;
    }
    .avatar-preview-large img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .avatar-modal-actions {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .avatar-modal-actions input[type="file"] {
      font-size: 0.8rem;
      color: var(--text-light);
    }
    .emp-avatar-large img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .emp-header-info {
      flex: 1;
    }
    .emp-header-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    .emp-name-large {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }
    .emp-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .status-indicator {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .status-indicator.active {
      background: #f0fff4;
      color: #22543d;
    }
    .status-indicator.active::before {
      content: "";
      width: 8px;
      height: 8px;
      background: #38a169;
      border-radius: 50%;
    }
    .status-indicator.leave {
      background: #fffaf0;
      color: #744210;
    }
    .status-indicator.leave::before {
      content: "";
      width: 8px;
      height: 8px;
      background: #dd6b20;
      border-radius: 50%;
    }
    .status-indicator.resigned {
      background: #fff5f5;
      color: #742a2a;
    }
    .status-indicator.resigned::before {
      content: "";
      width: 8px;
      height: 8px;
      background: #e53e3e;
      border-radius: 50%;
    }
    .emp-contact-list {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      margin-bottom: 0.8rem;
    }
    .emp-contact-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-light);
    }
    .emp-contact-item .icon {
      width: 18px;
      text-align: center;
      color: var(--text-light);
    }
    .emp-contact-item a {
      color: var(--primary-light);
      text-decoration: none;
    }
    .emp-contact-item a:hover {
      text-decoration: underline;
    }
    .emp-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .emp-tag {
      background: #faf5ff;
      color: var(--purple);
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 500;
    }

    /* Action Bar */
    .action-bar {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .action-bar-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .action-bar-right {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn {
      padding: 0.45rem 1rem;
      border: none;
      border-radius: 6px;
      font-size: 0.85rem;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-primary {
      background: var(--primary);
      color: var(--white);
    }
    .btn-primary:hover {
      background: var(--primary-dark);
    }
    .btn-secondary {
      background: #edf2f7;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      background: #e2e8f0;
    }
    .btn-purple {
      background: var(--purple);
      color: var(--white);
    }
    .btn-purple:hover {
      background: #6b46c1;
    }
    .btn-outline {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-outline:hover {
      background: var(--bg);
    }
    .btn-sm {
      padding: 0.3rem 0.7rem;
      font-size: 0.8rem;
    }
    .date-picker {
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--primary);
      border-radius: 6px;
      background: var(--white);
      color: var(--primary);
      font-weight: 600;
      cursor: pointer;
    }

    /* Tabs */
    .tabs-container {
      margin-bottom: 1.5rem;
    }
    .tabs {
      display: inline-flex;
    }
    .tab-item {
      padding: 0.6rem 1.1rem;
      border: 1px solid #d1d5db;
      margin-left: -1px;
      background: var(--white);
      cursor: pointer;
      font-size: 0.88rem;
      color: #374151;
      transition: all 0.15s ease;
      font-weight: 500;
      border-radius: 0;
    }
    .tab-item:first-child {
      margin-left: 0;
      border-radius: 4px 0 0 4px;
    }
    .tab-item:last-child {
      border-radius: 0 4px 4px 0;
    }
    .tab-item:hover {
      background: #f3f4f6;
      color: var(--primary);
    }
    .tab-item.active {
      color: #ffffff;
      border-color: #114187;
      background: #114187;
      font-weight: 600;
      position: relative;
      z-index: 1;
    }

    /* Main Content Layout */
    .main-content {
      display: flex;
      flex: 1;
      overflow: hidden;
    }
    .content-left {
      flex: 1;
      padding: 1.5rem;
      overflow-y: auto;
    }
    .content-right {
      width: 380px;
      background: var(--white);
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
    }

    /* Content Sections */
    .content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .section {
      background: var(--white);
      border-radius: 8px;
      box-shadow: var(--shadow);
      padding: 1rem 1.2rem;
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .section-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }
    .section-link {
      font-size: 0.8rem;
      color: var(--primary-light);
      text-decoration: none;
    }
    .section-link:hover {
      text-decoration: underline;
    }

    /* Info List */
    .info-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .info-row {
      display: flex;
    }
    .info-label {
      width: 100px;
      flex-shrink: 0;
      color: var(--text-light);
      font-size: 0.82rem;
    }
    .info-value {
      flex: 1;
      color: var(--text);
      font-size: 0.85rem;
    }
    .info-value .inline-edit-input {
      width: 100%;
      max-width: 100%;
      font-size: 0.85rem;
    }
    .info-value textarea.inline-edit-input {
      min-height: 80px;
      resize: vertical;
    }
    .info-value a {
      color: var(--primary-light);
      text-decoration: none;
    }
    .info-value a:hover {
      text-decoration: underline;
    }
    .info-value .manager-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .info-value .manager-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 600;
    }
    .address-block {
      line-height: 1.5;
    }

    /* Org Chart */
    .org-chart {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
    }
    .org-node {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.6rem 1rem;
      background: var(--bg);
      border-radius: 8px;
      min-width: 200px;
    }
    .org-node.current {
      border: 2px solid var(--primary);
      background: #ebf8ff;
    }
    .org-node.manager {
      border: 2px solid #667eea;
      background: #f5f3ff;
      cursor: pointer;
      transition:
        transform 0.2s,
        box-shadow 0.2s;
    }
    .org-node.manager:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }
    .org-node-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 0.85rem;
      font-weight: 600;
      flex-shrink: 0;
      overflow: hidden;
    }
    .org-node-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .org-node-info {
      flex: 1;
    }
    .org-node-name {
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--text);
    }
    .org-node-title {
      font-size: 0.78rem;
      color: var(--text-light);
    }
    .org-node-count {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .org-connector {
      width: 2px;
      height: 20px;
      background: var(--border);
    }
    .team-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      width: 100%;
    }
    .team-member {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.5rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
    }
    .team-member:hover {
      background: var(--bg);
    }
    .team-member-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ed8936, #dd6b20);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 0.72rem;
      font-weight: 600;
      flex-shrink: 0;
    }
    .team-member-name {
      font-size: 0.85rem;
      color: var(--primary-light);
    }

    /* Activity Panel */
    .activity-header {
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .activity-header .btn {
      flex: 1;
      justify-content: center;
    }
    .activity-list {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .activity-date-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .activity-date {
      font-size: 0.78rem;
      color: var(--text-light);
      text-align: center;
      margin: 0.25rem 0 0.2rem;
      padding-top: 0.25rem;
      border-top: 1px solid var(--border);
    }
    .activity-item {
      display: flex;
      gap: 0.8rem;
      padding: 0.8rem;
      background: #edf4ff;
      border: 1px solid #cbdcf9;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(17, 65, 135, 0.08);
    }
    .activity-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
    }
    .activity-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .activity-content {
      flex: 1;
    }
    .activity-author-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
    }
    .activity-author {
      font-weight: 600;
      font-size: 0.82rem;
      color: var(--text);
    }
    .activity-time {
      font-weight: 500;
      color: var(--text-light);
      font-size: 0.78rem;
      white-space: nowrap;
    }
    .memo-composer {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
      background: #fafafa;
    }
    .memo-composer textarea {
      width: 100%;
      min-height: 66px;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.6rem 0.75rem;
      font-size: 0.82rem;
      resize: vertical;
      font-family: inherit;
    }
    .memo-composer-actions {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
    }
    .activity-message {
      font-size: 0.85rem;
      color: var(--text);
      margin-top: 0.45rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .activity-message a {
      color: var(--primary-light);
      text-decoration: none;
    }
    .activity-message a:hover {
      text-decoration: underline;
    }

    /* Stats Row */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: var(--white);
      border-radius: 8px;
      padding: 1rem;
      box-shadow: var(--shadow);
      text-align: center;
    }
    .stat-card .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary);
    }
    .stat-card .stat-label {
      font-size: 0.78rem;
      color: var(--text-light);
      margin-top: 0.2rem;
    }

    /* Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .data-table th {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-light);
      font-weight: 600;
      font-size: 0.78rem;
    }
    .data-table td {
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid #f0f0f0;
      color: var(--text);
    }
    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* Badges */
    .badge {
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .badge-active {
      background: #c6f6d5;
      color: #22543d;
    }
    .badge-pending {
      background: #fefcbf;
      color: #744210;
    }
    .badge-expired {
      background: #fed7d7;
      color: #742a2a;
    }
    .badge-warning {
      background: #feebc8;
      color: #744210;
    }

    /* Skill Bars */
    .skill-item {
      margin-bottom: 0.8rem;
    }
    .skill-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.3rem;
    }
    .skill-name {
      font-size: 0.85rem;
      color: var(--text);
    }
    .skill-level {
      font-size: 0.78rem;
      color: var(--text-light);
    }
    .skill-bar {
      height: 6px;
      background: var(--border);
      border-radius: 3px;
      overflow: hidden;
    }
    .skill-bar-fill {
      height: 100%;
      background: var(--primary);
      border-radius: 3px;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 2rem;
      color: var(--text-light);
    }
    .empty-state .icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    /* Tab Content Panels */
    .tab-panel {
      display: none;
    }
    .tab-panel.active {
      display: block;
    }
  </style>

  <apex:form id="detailsForm">
    <apex:pageMessages id="pageMessages" />
    <apex:inputHidden id="activeTab" value="{!activeTab}" />
    <div class="details-wrap">
      <c:JIP_HRSidebar activePage="employee" />

      <!-- Main Content -->
      <div class="details-main">
        <!-- Top Bar -->
        <div class="top-bar">
          <div class="top-bar-left">
            <a
              href="{!URLFOR($Page.JIP_WorkerManagementPage)}"
              class="nav-link"
            >
              ← 従業員一覧
            </a>
            <span style="color: var(--text-light)">|</span>
            <apex:outputPanel rendered="{!NOT(isCreateMode)}">
              <span>{!worker.Name}</span>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isCreateMode}">
              <span>新規登録</span>
            </apex:outputPanel>
          </div>
          <div class="top-bar-actions">
            <apex:outputPanel rendered="{!AND(NOT(isEditMode), NOT(isCreateMode))}"
            >
              <apex:commandButton value="✏️ 編集"
                action="{!editWorker}"
                styleClass="btn-edit"
              />
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isEditMode}">
              <div class="edit-actions">
                <apex:commandButton value="💾 保存"
                  action="{!saveWorker}"
                  styleClass="btn-edit"
                />
                <apex:commandButton value="キャンセル"
                  action="{!cancelEdit}"
                  immediate="true"
                  styleClass="btn-cancel"
                />
              </div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(isCreateMode)}">
              <span class="icon-btn">📋 書類</span>
              <span class="icon-btn">💰 給与明細</span>
              <span class="icon-btn">📅 計画</span>
              <span class="icon-btn">🏖️ 休暇</span>
              <span class="icon-btn">⏰ タイムシート</span>
            </apex:outputPanel>
          </div>
        </div>

        <!-- Employee Header -->
        <div class="emp-header">
          <div class="emp-avatar-wrap">
            <apex:outputPanel id="avatarPanel" layout="block">
              <button
                type="button"
                class="avatar-trigger"
                onclick="openAvatarModal()"
              >
                <div class="emp-avatar-large">
                  <apex:outputPanel rendered="{!hasAvatar}">
                    <img src="{!avatarUrl}" alt="avatar" />
                  </apex:outputPanel>
                  <apex:outputPanel rendered="{!NOT(hasAvatar)}">
                    {!workerInitials}
                  </apex:outputPanel>
                </div>
              </button>
            </apex:outputPanel>
          </div>
          <div class="emp-header-info">
            <div class="emp-header-top">
              <apex:outputPanel rendered="{!NOT(isEditMode)}">
                <div
                  style="
                    font-size: 0.78rem;
                    color: var(--text-light);
                    margin-bottom: 0.15rem;
                  "
                >
                  氏名
                </div>
                <h1 class="emp-name-large">{!workerFullName}</h1>
              </apex:outputPanel>
              <apex:outputPanel rendered="{!isEditMode}">
                <div
                  style="
                    font-size: 0.78rem;
                    color: var(--text-light);
                    margin-bottom: 0.15rem;
                  "
                >
                  氏名
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center">
                  <apex:inputField value="{!worker.LastName__c}"
                    styleClass="inline-edit-input"
                  />
                  <apex:inputField value="{!worker.FirstName__c}"
                    styleClass="inline-edit-input"
                  />
                </div>
              </apex:outputPanel>
              <div class="emp-status">
                <span
                  class="status-indicator {!IF(worker.EmploymentStatus__c == '在職', 'active', IF(worker.EmploymentStatus__c == '休職', 'leave', 'resigned'))}"
                >
                  {!IF(worker.EmploymentStatus__c == '在職', '在席',
                  IF(worker.EmploymentStatus__c == '休職', '休職中', '退職'))}
                </span>
              </div>
            </div>
            <div class="emp-contact-list">
              <div class="emp-contact-item">
                <span class="icon">🎂</span>
                <span style="min-width: 66px; color: var(--text-light)"
                  >生年月日</span
                >
                <apex:outputPanel rendered="{!NOT(isEditMode)}">
                  <apex:outputText value="{0, date, yyyy/MM/dd}">
                    <apex:param value="{!worker.BirthDate__c}" />
                  </apex:outputText>
                </apex:outputPanel>
                <apex:inputField rendered="{!isEditMode}"
                  value="{!worker.BirthDate__c}"
                  styleClass="inline-edit-input"
                />
              </div>
              <div class="emp-contact-item">
                <span class="icon">⚧</span>
                <span style="min-width: 66px; color: var(--text-light)"
                  >性別</span
                >
                <apex:outputPanel rendered="{!NOT(isEditMode)}"
                  >{!worker.Gender__c}</apex:outputPanel>
                <apex:inputField rendered="{!isEditMode}"
                  value="{!worker.Gender__c}"
                  styleClass="inline-edit-input"
                />
              </div>
              <div class="emp-contact-item">
                <span class="icon">✉️</span>
                <apex:outputPanel rendered="{!NOT(isEditMode) && NOT(ISBLANK(worker.Email__c))}"
                >
                  <a href="mailto:{!worker.Email__c}">{!worker.Email__c}</a>
                </apex:outputPanel>
                <apex:inputField rendered="{!isEditMode}"
                  value="{!worker.Email__c}"
                  styleClass="inline-edit-input"
                />
              </div>
              <div class="emp-contact-item">
                <span class="icon">📞</span>
                <apex:outputPanel rendered="{!NOT(isEditMode) && NOT(ISBLANK(worker.Phone__c))}"
                >
                  {!worker.Phone__c}
                </apex:outputPanel>
                <apex:inputField rendered="{!isEditMode}"
                  value="{!worker.Phone__c}"
                  styleClass="inline-edit-input"
                />
              </div>
              <div class="emp-contact-item">
                <span class="icon">🏷️</span>
                <apex:outputPanel rendered="{!NOT(isEditMode)}">
                  <span>{!worker.Position__c}</span>
                </apex:outputPanel>
                <apex:inputField rendered="{!isEditMode}"
                  value="{!worker.Position__c}"
                  styleClass="inline-edit-input"
                />
              </div>
            </div>
            <div class="emp-tags">
              <apex:outputPanel rendered="{!NOT(isEditMode)}">
                <span class="emp-tag">{!worker.ContractType__c}</span>
              </apex:outputPanel>
              <apex:inputField rendered="{!isEditMode}"
                value="{!worker.ContractType__c}"
                styleClass="inline-edit-input"
              />
            </div>
          </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
          <div class="content-left">
            <!-- Tabs -->
            <div class="tabs-container">
              <div class="tabs">
                <button
                  type="button"
                  class="tab-item {!IF(activeTab == 'work', 'active', '')}"
                  onclick="setTab('work')"
                >
                  仕事</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'resume', 'active', '')}"
                  onclick="setTab('resume')"
                >
                  履歴書</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'personal', 'active', '')}"
                  onclick="setTab('personal')"
                >
                  パーソナル</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'salary', 'active', '')}"
                  onclick="setTab('salary')"
                >
                  給与</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'skills', 'active', '')}"
                  onclick="setTab('skills')"
                >
                  スキル</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'attendance', 'active', '')}"
                  onclick="setTab('attendance')"
                >
                  勤怠</button
                ><button
                  type="button"
                  class="tab-item {!IF(activeTab == 'settings', 'active', '')}"
                  onclick="setTab('settings')"
                >
                  管理設定
                </button>
              </div>
            </div>

            <!-- Work Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'work', 'active', '')}"
              id="tab-work"
            >
              <div class="content-grid">
                <!-- Work Info Section -->
                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">勤務</h3>
                  </div>
                  <div class="info-list">
                    <div class="info-row">
                      <span class="info-label">部門</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.Department__r.Name}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.Department__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">職位</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.Position__c}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.Position__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">雇用形態</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.ContractType__c}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.ContractType__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">入社日</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}">
                          <apex:outputText value="{0, date, yyyy/MM/dd}">
                            <apex:param value="{!worker.HireDate__c}" />
                          </apex:outputText>
                        </apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.HireDate__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Location Section -->
                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">ロケーション</h3>
                  </div>
                  <div class="info-list">
                    <div class="info-row">
                      <span class="info-label">職場アドレス</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}">
                          <div class="address-block">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(worker.PostalCode__c))}"
                            >
                              〒{!worker.PostalCode__c}<br />
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!NOT(ISBLANK(worker.Address__c))}"
                            >
                              {!worker.Address__c}
                            </apex:outputPanel>
                          </div>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!isEditMode}">
                          <div
                            style="
                              display: flex;
                              flex-direction: column;
                              gap: 0.4rem;
                            "
                          >
                            <apex:inputField value="{!worker.PostalCode__c}"
                              styleClass="inline-edit-input"
                            />
                            <apex:inputField value="{!worker.Address__c}"
                              styleClass="inline-edit-input"
                            />
                          </div>
                        </apex:outputPanel>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Organization Chart Section -->
                <div class="section" style="grid-column: span 2">
                  <div class="section-header">
                    <h3 class="section-title">組織図</h3>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(departmentName))}"
                    >
                      <span style="color: #666; font-size: 0.9rem"
                        >📍 {!departmentName}</span
                      >
                    </apex:outputPanel>
                  </div>
                  <div class="org-chart">
                    <!-- Manager (上司) -->
                    <apex:outputPanel rendered="{!hasManager}">
                      <a
                        href="/apex/JIP_WorkerDetailsPage?id={!managerId}"
                        class="org-node manager"
                        style="text-decoration: none"
                      >
                        <div
                          class="org-node-avatar"
                          style="
                            background: linear-gradient(
                              135deg,
                              #667eea 0%,
                              #764ba2 100%
                            );
                          "
                        >
                          {!managerInitials}
                        </div>
                        <div class="org-node-info">
                          <div
                            class="org-node-label"
                            style="
                              font-size: 0.7rem;
                              color: #667eea;
                              font-weight: 500;
                            "
                          >
                            上司
                          </div>
                          <div class="org-node-name">{!managerName}</div>
                          <div class="org-node-title">{!managerPosition}</div>
                        </div>
                      </a>
                      <div class="org-connector"></div>
                    </apex:outputPanel>

                    <!-- Current Employee -->
                    <div class="org-node current">
                      <div class="org-node-avatar">{!workerInitials}</div>
                      <div class="org-node-info">
                        <div class="org-node-name">{!workerFullName}</div>
                        <div class="org-node-title">{!worker.Position__c}</div>
                      </div>
                      <apex:outputPanel rendered="{!teamMembers.size > 0}">
                        <span class="org-node-count">{!teamMembers.size}</span>
                      </apex:outputPanel>
                    </div>

                    <!-- Subordinates (部下) -->
                    <apex:outputPanel rendered="{!teamMembers.size > 0}">
                      <div class="org-connector"></div>
                      <div
                        class="team-label"
                        style="
                          text-align: center;
                          font-size: 0.75rem;
                          color: #888;
                          margin-bottom: 0.5rem;
                        "
                      >
                        部下
                      </div>
                      <div class="team-list">
                        <apex:repeat value="{!teamMembers}" var="member">
                          <a
                            href="/apex/JIP_WorkerDetailsPage?id={!member.recordId}"
                            class="team-member"
                          >
                            <div class="team-member-avatar">
                              {!member.initials}
                            </div>
                            <span class="team-member-name"
                              >{!member.fullName}</span
                            >
                          </a>
                        </apex:repeat>
                      </div>
                    </apex:outputPanel>
                  </div>
                </div>
              </div>
            </div>

            <!-- Resume Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'resume', 'active', '')}"
              id="tab-resume"
            >
              <div class="section">
                <div class="section-header">
                  <h3 class="section-title">📝 履歴書</h3>
                </div>
                <div class="empty-state">
                  <div class="icon">📄</div>
                  <p>履歴書情報がありません</p>
                </div>
              </div>
            </div>

            <!-- Personal Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'personal', 'active', '')}"
              id="tab-personal"
            >
              <div class="content-grid">
                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">👤 個人情報</h3>
                  </div>
                  <div class="info-list">
                    <div class="info-row">
                      <span class="info-label">氏名（カナ）</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.LastNameKana__c}
                          {!worker.FirstNameKana__c}</apex:outputPanel>
                        <apex:outputPanel rendered="{!isEditMode}">
                          <div style="display: flex; gap: 0.4rem">
                            <apex:inputField value="{!worker.LastNameKana__c}"
                              styleClass="inline-edit-input"
                            />
                            <apex:inputField value="{!worker.FirstNameKana__c}"
                              styleClass="inline-edit-input"
                            />
                          </div>
                        </apex:outputPanel>
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">生年月日</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}">
                          <apex:outputText value="{0, date, yyyy/MM/dd}">
                            <apex:param value="{!worker.BirthDate__c}" />
                          </apex:outputText>
                        </apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.BirthDate__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">性別</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.Gender__c}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.Gender__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                  </div>
                </div>

                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">🆘 緊急連絡先</h3>
                  </div>
                  <div class="info-list">
                    <div class="info-row">
                      <span class="info-label">連絡先名</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.EmergencyContactName__c}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.EmergencyContactName__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">電話番号</span>
                      <span class="info-value">
                        <apex:outputPanel rendered="{!NOT(isEditMode)}"
                          >{!worker.EmergencyContactPhone__c}</apex:outputPanel>
                        <apex:inputField rendered="{!isEditMode}"
                          value="{!worker.EmergencyContactPhone__c}"
                          styleClass="inline-edit-input"
                        />
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Salary Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'salary', 'active', '')}"
              id="tab-salary"
            >
              <div class="section">
                <div class="section-header">
                  <h3 class="section-title">💰 給与情報</h3>
                </div>
                <div class="info-list">
                  <div class="info-row">
                    <span class="info-label">銀行名</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.BankName__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.BankName__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">支店名</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.BankBranch__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.BankBranch__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">口座種類</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.BankAccountType__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.BankAccountType__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">口座番号</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.BankAccountNumber__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.BankAccountNumber__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Skills Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'skills', 'active', '')}"
              id="tab-skills"
            >
              <div class="stats-row">
                <div class="stat-card">
                  <div class="stat-value">{!skillCount}</div>
                  <div class="stat-label">スキル数</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">{!certCount}</div>
                  <div class="stat-label">資格数</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">{!trainingCount}</div>
                  <div class="stat-label">研修参加</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">{!recentAttendances.size}</div>
                  <div class="stat-label">今月出勤</div>
                </div>
              </div>

              <div class="content-grid">
                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">💡 スキル</h3>
                  </div>
                  <apex:outputPanel rendered="{!skills.size == 0}">
                    <div class="empty-state">
                      <p>登録されたスキルがありません</p>
                    </div>
                  </apex:outputPanel>
                  <apex:outputPanel rendered="{!skills.size > 0}">
                    <apex:repeat value="{!skills}" var="skill">
                      <div class="skill-item">
                        <div class="skill-header">
                          <span class="skill-name">{!skill.skillName}</span>
                          <span class="skill-level"
                            >{!skill.proficiencyLabel}</span
                          >
                        </div>
                        <div class="skill-bar">
                          <div
                            class="skill-bar-fill"
                            style="width: {!skill.proficiencyLevel * 25}%;"
                          ></div>
                        </div>
                      </div>
                    </apex:repeat>
                  </apex:outputPanel>
                </div>

                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">🏆 資格</h3>
                  </div>
                  <apex:outputPanel rendered="{!certifications.size == 0}">
                    <div class="empty-state">
                      <p>登録された資格がありません</p>
                    </div>
                  </apex:outputPanel>
                  <apex:outputPanel rendered="{!certifications.size > 0}">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>資格名</th>
                          <th>発行機関</th>
                          <th>有効期限</th>
                          <th>状態</th>
                        </tr>
                      </thead>
                      <tbody>
                        <apex:repeat value="{!certifications}" var="cert">
                          <tr>
                            <td>{!cert.certName}</td>
                            <td>{!cert.issuingOrg}</td>
                            <td>
                              <apex:outputText value="{0, date, yyyy/MM/dd}">
                                <apex:param value="{!cert.expirationDate}" />
                              </apex:outputText>
                            </td>
                            <td>
                              <span
                                class="badge {!IF(cert.isExpiringSoon, 'badge-warning', 'badge-active')}"
                              >
                                {!cert.status}
                              </span>
                            </td>
                          </tr>
                        </apex:repeat>
                      </tbody>
                    </table>
                  </apex:outputPanel>
                </div>
              </div>
            </div>

            <!-- Attendance Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'attendance', 'active', '')}"
              id="tab-attendance"
            >
              <div class="stats-row">
                <div class="stat-card">
                  <div class="stat-value">{!totalWorkDays}</div>
                  <div class="stat-label">今月の出勤日数</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">{!totalOvertimeHours}h</div>
                  <div class="stat-label">今月の残業時間</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">{!totalLeaveDays}</div>
                  <div class="stat-label">今年の有給取得日数</div>
                </div>
                <div class="stat-card">
                  <div class="stat-value">-</div>
                  <div class="stat-label">休暇申請数</div>
                </div>
              </div>

              <div class="content-grid">
                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">⏰ 最近の出勤記録</h3>
                  </div>
                  <apex:outputPanel rendered="{!recentAttendances.size == 0}">
                    <div class="empty-state">
                      <p>出勤記録がありません</p>
                    </div>
                  </apex:outputPanel>
                  <apex:outputPanel rendered="{!recentAttendances.size > 0}">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>日付</th>
                          <th>出勤</th>
                          <th>退勤</th>
                          <th>勤務時間</th>
                          <th>残業</th>
                        </tr>
                      </thead>
                      <tbody>
                        <apex:repeat value="{!recentAttendances}" var="att">
                          <tr>
                            <td>
                              <apex:outputText value="{0, date, MM/dd}">
                                <apex:param value="{!att.attendanceDate}" />
                              </apex:outputText>
                            </td>
                            <td>{!att.checkInTime}</td>
                            <td>{!att.checkOutTime}</td>
                            <td>{!att.workHours}h</td>
                            <td>{!att.overtimeHours}h</td>
                          </tr>
                        </apex:repeat>
                      </tbody>
                    </table>
                  </apex:outputPanel>
                </div>

                <div class="section">
                  <div class="section-header">
                    <h3 class="section-title">🏖️ 休暇申請履歴</h3>
                  </div>
                  <div class="empty-state">
                    <p>休暇申請機能は準備中です</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Settings Tab -->
            <div
              class="tab-panel {!IF(activeTab == 'settings', 'active', '')}"
              id="tab-settings"
            >
              <div class="section">
                <div class="section-header">
                  <h3 class="section-title">⚙️ 管理設定</h3>
                </div>
                <div class="info-list">
                  <div class="info-row">
                    <span class="info-label">従業員コード</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.Worker_Code__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.Worker_Code__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">社会保険番号</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.InsuranceNumber__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.InsuranceNumber__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">マイナンバー</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.MyNumber__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.MyNumber__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-label">備考</span>
                    <span class="info-value">
                      <apex:outputPanel rendered="{!NOT(isEditMode)}"
                        >{!worker.Notes__c}</apex:outputPanel>
                      <apex:inputField rendered="{!isEditMode}"
                        value="{!worker.Notes__c}"
                        styleClass="inline-edit-input"
                      />
                    </span>
                  </div>
                </div>
              </div>

              <!-- System Login Account Section -->
              <apex:outputPanel id="accountPanel">
                <apex:pageMessages id="accountMessages" />
                <div class="section" style="margin-top: 1.5rem">
                  <div class="section-header">
                    <h3 class="section-title">🔐 システムログインアカウント</h3>
                    <apex:outputPanel rendered="{!NOT(hasSystemAccount)}">
                      <apex:commandButton value="＋ アカウント発行"
                        action="{!openAccountModal}"
                        styleClass="btn btn-primary btn-sm"
                        rerender="accountModal,accountPanel"
                      />
                    </apex:outputPanel>
                  </div>

                  <!-- No Account State -->
                  <apex:outputPanel rendered="{!NOT(hasSystemAccount)}">
                    <div
                      style="
                        text-align: center;
                        padding: 2rem;
                        color: var(--text-light);
                      "
                    >
                      <div style="font-size: 2.5rem; margin-bottom: 0.5rem">
                        🔒
                      </div>
                      <p style="margin: 0">
                        システムログインアカウントは未発行です
                      </p>
                      <p style="margin: 0.3rem 0 0 0; font-size: 0.8rem">
                        上のボタンからアカウントを発行してください
                      </p>
                    </div>
                  </apex:outputPanel>

                  <!-- Account Exists State -->
                  <apex:outputPanel rendered="{!hasSystemAccount}">
                    <div class="info-list">
                      <div class="info-row">
                        <span class="info-label">アカウント種別</span>
                        <span class="info-value">
                          <span
                            class="status-indicator {!IF(worker.SystemLoginType__c == 'SalesforceUser', 'active', 'leave')}"
                            style="display: inline-flex"
                          >
                            {!IF(worker.SystemLoginType__c == 'SalesforceUser',
                            'Salesforceユーザー', 'ゲストアカウント')}
                          </span>
                        </span>
                      </div>
                      <div class="info-row">
                        <span class="info-label">ログインID</span>
                        <span class="info-value"
                          >{!worker.SystemUsername__c}</span
                        >
                      </div>
                      <div class="info-row">
                        <span class="info-label">システムロール</span>
                        <span class="info-value">
                          <span class="emp-tag">{!systemRoleLabel}</span>
                        </span>
                      </div>
                      <div class="info-row">
                        <span class="info-label">アカウント状態</span>
                        <span class="info-value">
                          <span
                            class="status-indicator {!IF(worker.SystemAccountActive__c, 'active', 'resigned')}"
                            style="display: inline-flex"
                          >
                            {!IF(worker.SystemAccountActive__c, '有効', '無効')}
                          </span>
                        </span>
                      </div>
                      <apex:outputPanel rendered="{!worker.SystemLoginType__c == 'SalesforceUser' && worker.User__c != null}"
                      >
                        <div class="info-row">
                          <span class="info-label">SFユーザー</span>
                          <span class="info-value">
                            <a href="/{!worker.User__c}" target="_blank"
                              >{!linkedUserName}</a
                            >
                          </span>
                        </div>
                      </apex:outputPanel>
                      <div class="info-row">
                        <span class="info-label">発行日</span>
                        <span class="info-value">
                          <apex:outputText value="{0,date,yyyy/MM/dd HH:mm}">
                            <apex:param value="{!worker.SystemAccountCreatedDate__c}"
                            />
                          </apex:outputText>
                        </span>
                      </div>
                    </div>
                    <div
                      style="
                        margin-top: 1rem;
                        padding-top: 1rem;
                        border-top: 1px solid var(--border);
                        display: flex;
                        gap: 0.5rem;
                      "
                    >
                      <apex:commandButton value="🔄 パスワードリセット"
                        action="{!resetAccountPassword}"
                        styleClass="btn btn-secondary btn-sm"
                        rerender="accountPanel,pageMessages"
                        rendered="{!worker.SystemLoginType__c == 'Guest'}"
                        onclick="
                          if (
                            !confirm(
                              'パスワードをリセットしてもよろしいですか？'
                            )
                          ) {
                            return false;
                          }
                        "
                      />
                      <apex:commandButton value="{!IF(worker.SystemAccountActive__c, '🚫 無効化', '✅ 有効化')}"
                        action="{!toggleAccountStatus}"
                        styleClass="btn {!IF(worker.SystemAccountActive__c, 'btn-secondary', 'btn-primary')} btn-sm"
                        rerender="accountPanel,pageMessages"
                      />
                      <apex:commandButton value="🗑️ アカウント削除"
                        action="{!deleteSystemAccount}"
                        styleClass="btn btn-sm"
                        style="background: var(--danger); color: white"
                        rerender="accountPanel,pageMessages"
                        immediate="true"
                      />
                    </div>
                  </apex:outputPanel>
                </div>
              </apex:outputPanel>
            </div>
          </div>

          <!-- Right Panel - Activity Feed -->
          <apex:outputPanel rendered="{!NOT(isCreateMode)}"
            layout="block"
            styleClass="content-right"
          >
            <apex:outputPanel id="activityFeedPanel" layout="block">
              <div class="activity-header">
                <apex:commandButton value="メール送信"
                  action="{!showMessageFeed}"
                  reRender="activityFeedPanel"
                  styleClass="{!messageBtnClass}"
                />
                <apex:commandButton value="メモを記録"
                  action="{!showMemoFeed}"
                  reRender="activityFeedPanel"
                  styleClass="{!memoBtnClass}"
                />
                <apex:commandButton value="活動"
                  action="{!showActivityFeed}"
                  reRender="activityFeedPanel"
                  styleClass="{!activityBtnClass}"
                />
              </div>

              <apex:outputPanel rendered="{!showMemoComposer}"
                layout="block"
                styleClass="memo-composer"
              >
                <apex:inputTextarea value="{!newMemoText}"
                  html-placeholder="内部メモを記録する..."
                />
                <div class="memo-composer-actions">
                  <apex:commandButton value="ログ"
                    action="{!saveMemo}"
                    reRender="activityFeedPanel"
                    styleClass="btn btn-purple btn-sm"
                  />
                  <apex:commandButton value="キャンセル"
                    action="{!cancelMemoComposer}"
                    immediate="true"
                    reRender="activityFeedPanel"
                    styleClass="btn btn-outline btn-sm"
                  />
                </div>
              </apex:outputPanel>

              <div class="activity-list">
                <apex:outputPanel rendered="{!activities.size == 0}">
                  <div class="empty-state">
                    <div class="icon">📝</div>
                    <p>データがありません</p>
                  </div>
                </apex:outputPanel>
                <apex:repeat value="{!activities}" var="activity">
                  <div class="activity-date-group">
                    <apex:outputPanel rendered="{!activity.showDateHeader}">
                      <div class="activity-date">{!activity.formattedDate}</div>
                    </apex:outputPanel>
                    <div class="activity-item">
                      <div class="activity-content">
                        <div class="activity-author-row">
                          <div class="activity-time">
                            {!activity.formattedTime}
                          </div>
                        </div>
                        <apex:outputPanel rendered="{!NOT(ISBLANK(activity.subLabel))}"
                        >
                          <div>{!activity.subLabel}</div>
                        </apex:outputPanel>
                        <div>{!activity.message}</div>
                      </div>
                    </div>
                  </div>
                </apex:repeat>

                <apex:outputPanel rendered="{!hasMoreActivities}">
                  <div style="padding: 0.5rem 0 1rem; text-align: center">
                    <apex:commandButton value="もっと見る"
                      action="{!loadMoreActivities}"
                      reRender="activityFeedPanel"
                      styleClass="btn btn-outline btn-sm"
                    />
                  </div>
                </apex:outputPanel>
              </div>
            </apex:outputPanel>
          </apex:outputPanel>
        </div>
      </div>
    </div>

    <!-- Account Creation Modal -->
    <apex:outputPanel id="accountModal">
      <apex:outputPanel rendered="{!showAccountModal}"
        layout="block"
        styleClass="modal-overlay"
        style="
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.5);
          z-index: 9999;
          display: flex;
          align-items: center;
          justify-content: center;
        "
      >
        <div
          class="modal-content"
          style="
            background: var(--white);
            border-radius: 12px;
            width: 500px;
            max-width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
          "
        >
          <div
            class="modal-header"
            style="
              padding: 1.2rem 1.5rem;
              border-bottom: 1px solid var(--border);
              display: flex;
              align-items: center;
              justify-content: space-between;
            "
          >
            <h2 style="margin: 0; font-size: 1.1rem; font-weight: 700">
              🔐 システムアカウント発行
            </h2>
            <apex:commandButton value="✕"
              action="{!closeAccountModal}"
              styleClass="btn"
              style="
                background: transparent;
                border: none;
                font-size: 1.2rem;
                padding: 0.2rem 0.5rem;
                cursor: pointer;
              "
              rerender="accountModal"
            />
          </div>

          <div class="modal-body" style="padding: 1.5rem">
            <apex:pageMessages id="modalMessages" />

            <!-- Account Type Selection -->
            <div class="form-group" style="margin-bottom: 1.2rem">
              <label
                style="
                  display: block;
                  font-weight: 600;
                  margin-bottom: 0.5rem;
                  font-size: 0.9rem;
                "
                >アカウント種別</label
              >
              <apex:selectList value="{!newAccountType}"
                size="1"
                styleClass="form-input"
                style="
                  width: 100%;
                  padding: 0.6rem;
                  border: 1px solid var(--border);
                  border-radius: 6px;
                  font-size: 0.9rem;
                "
              >
                <apex:selectOptions value="{!accountTypeOptions}" />
                <apex:actionSupport event="onchange"
                  rerender="accountModalBody"
                />
              </apex:selectList>
              <p
                style="
                  margin: 0.4rem 0 0;
                  font-size: 0.78rem;
                  color: var(--text-light);
                "
              >
                <apex:outputPanel rendered="{!newAccountType == 'Guest'}">
                  ゲストアカウント:
                  Salesforceライセンス不要。メールアドレスとパスワードでログイン。
                </apex:outputPanel>
                <apex:outputPanel rendered="{!newAccountType == 'SalesforceUser'}"
                >
                  Salesforce連携:
                  既存のSalesforceユーザーと紐付け。SSOでログイン可能。
                </apex:outputPanel>
              </p>
            </div>

            <apex:outputPanel id="accountModalBody">
              <!-- Guest Account Fields -->
              <apex:outputPanel rendered="{!newAccountType == 'Guest'}">
                <div class="form-group" style="margin-bottom: 1.2rem">
                  <label
                    style="
                      display: block;
                      font-weight: 600;
                      margin-bottom: 0.5rem;
                      font-size: 0.9rem;
                    "
                    >ログインID（メールアドレス）</label
                  >
                  <div
                    style="
                      padding: 0.6rem;
                      background: #f8fafc;
                      border: 1px solid var(--border);
                      border-radius: 6px;
                      color: var(--text);
                    "
                  >
                    {!worker.Email__c}
                    <apex:outputPanel rendered="{!ISBLANK(worker.Email__c)}">
                      <span style="color: var(--danger)"
                        >⚠️ メールアドレスが未設定です</span
                      >
                    </apex:outputPanel>
                  </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.2rem">
                  <label
                    style="
                      display: block;
                      font-weight: 600;
                      margin-bottom: 0.5rem;
                      font-size: 0.9rem;
                    "
                    >パスワード</label
                  >
                  <div style="display: flex; gap: 0.5rem; align-items: center">
                    <apex:inputText value="{!newAccountPassword}"
                      html-placeholder="自動生成パスワードを使用"
                      styleClass="form-input"
                      style="
                        flex: 1;
                        padding: 0.6rem;
                        border: 1px solid var(--border);
                        border-radius: 6px;
                        font-size: 0.9rem;
                      "
                    />
                  </div>
                  <div
                    style="
                      margin-top: 0.5rem;
                      padding: 0.5rem;
                      background: #fffbeb;
                      border: 1px solid #fbbf24;
                      border-radius: 6px;
                    "
                  >
                    <span style="font-size: 0.82rem"
                      >📋 自動生成:
                      <strong
                        style="
                          font-family: monospace;
                          background: #fef3c7;
                          padding: 0.2rem 0.4rem;
                          border-radius: 4px;
                        "
                        >{!generatedPassword}</strong
                      ></span
                    >
                    <apex:commandButton value="🔄 再生成"
                      action="{!regeneratePassword}"
                      styleClass="btn btn-sm"
                      style="
                        margin-left: 0.5rem;
                        padding: 0.2rem 0.5rem;
                        font-size: 0.75rem;
                        background: #fbbf24;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                      "
                      rerender="accountModalBody"
                    />
                  </div>
                  <p
                    style="
                      margin: 0.4rem 0 0;
                      font-size: 0.78rem;
                      color: var(--text-light);
                    "
                  >
                    空欄の場合は自動生成パスワードが使用されます
                  </p>
                </div>
              </apex:outputPanel>

              <!-- Salesforce User Fields -->
              <apex:outputPanel rendered="{!newAccountType == 'SalesforceUser'}"
              >
                <div class="form-group" style="margin-bottom: 1.2rem">
                  <label
                    style="
                      display: block;
                      font-weight: 600;
                      margin-bottom: 0.5rem;
                      font-size: 0.9rem;
                    "
                    >Salesforceユーザー</label
                  >
                  <apex:selectList value="{!selectedSalesforceUserId}"
                    size="1"
                    styleClass="form-input"
                    style="
                      width: 100%;
                      padding: 0.6rem;
                      border: 1px solid var(--border);
                      border-radius: 6px;
                      font-size: 0.9rem;
                    "
                  >
                    <apex:selectOptions value="{!salesforceUserOptions}" />
                  </apex:selectList>
                  <p
                    style="
                      margin: 0.4rem 0 0;
                      font-size: 0.78rem;
                      color: var(--text-light);
                    "
                  >
                    他の従業員に紐付けられていないアクティブユーザーのみ表示
                  </p>
                </div>
              </apex:outputPanel>

              <!-- System Role -->
              <div class="form-group" style="margin-bottom: 1.2rem">
                <label
                  style="
                    display: block;
                    font-weight: 600;
                    margin-bottom: 0.5rem;
                    font-size: 0.9rem;
                  "
                  >システムロール</label
                >
                <apex:selectList value="{!newAccountRole}"
                  size="1"
                  styleClass="form-input"
                  style="
                    width: 100%;
                    padding: 0.6rem;
                    border: 1px solid var(--border);
                    border-radius: 6px;
                    font-size: 0.9rem;
                  "
                >
                  <apex:selectOptions value="{!accountRoleOptions}" />
                </apex:selectList>
                <div
                  style="
                    margin-top: 0.5rem;
                    font-size: 0.78rem;
                    color: var(--text-light);
                  "
                >
                  <div
                    style="
                      display: grid;
                      grid-template-columns: 1fr 1fr;
                      gap: 0.3rem;
                    "
                  >
                    <span>👑 管理者: 全機能アクセス</span>
                    <span>📊 マネージャー: 部門管理</span>
                    <span>👤 一般社員: 自己情報編集</span>
                    <span>👁️ 閲覧のみ: 参照のみ</span>
                  </div>
                </div>
              </div>
            </apex:outputPanel>
          </div>

          <div
            class="modal-footer"
            style="
              padding: 1rem 1.5rem;
              border-top: 1px solid var(--border);
              display: flex;
              justify-content: flex-end;
              gap: 0.5rem;
              background: #f8fafc;
            "
          >
            <apex:commandButton value="キャンセル"
              action="{!closeAccountModal}"
              styleClass="btn btn-secondary"
              style="
                padding: 0.6rem 1.2rem;
                border: 1px solid var(--border);
                border-radius: 6px;
                background: var(--white);
                cursor: pointer;
              "
              rerender="accountModal"
            />
            <apex:commandButton value="アカウント発行"
              action="{!createSystemAccount}"
              styleClass="btn btn-primary"
              style="
                padding: 0.6rem 1.2rem;
                border: none;
                border-radius: 6px;
                background: var(--primary);
                color: white;
                font-weight: 600;
                cursor: pointer;
              "
              rerender="accountPanel,accountModal,modalMessages"
            />
          </div>
        </div>
      </apex:outputPanel>
    </apex:outputPanel>
  </apex:form>

  <apex:form id="avatarForm" enctype="multipart/form-data">
    <apex:inputHidden id="activeTab" value="{!activeTab}" />
    <apex:inputHidden id="avatarCompressedBase64"
      value="{!avatarCompressedBase64}"
    />
    <apex:inputHidden id="avatarCompressedFileName"
      value="{!avatarCompressedFileName}"
    />
    <div
      id="avatarModal"
      class="avatar-modal"
      onclick="closeAvatarModal(event)"
    >
      <div class="avatar-modal-card" onclick="event.stopPropagation()">
        <div class="avatar-modal-header">
          <h3 class="avatar-modal-title">アバター画像</h3>
          <button
            type="button"
            class="avatar-modal-close"
            onclick="closeAvatarModal()"
          >
            ×
          </button>
        </div>
        <div class="avatar-modal-body">
          <div class="avatar-preview-large">
            <apex:outputPanel rendered="{!hasAvatar}">
              <img src="{!avatarUrl}" alt="avatar preview" />
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(hasAvatar)}">
              {!workerInitials}
            </apex:outputPanel>
          </div>
          <div class="avatar-modal-actions">
            <apex:outputPanel rendered="{!NOT(isCreateMode)}">
              <apex:inputFile id="avatarInput"
                value="{!avatarBody}"
                filename="{!avatarFileName}"
                accept="image/*"
              />
              <apex:commandButton id="uploadAvatarBtn"
                value="画像アップロード"
                action="{!uploadAvatar}"
                styleClass="btn btn-primary"
                onclick="prepareCompressedAvatarUpload(event)"
              />
              <apex:commandButton id="hiddenUploadTrigger"
                action="{!uploadAvatar}"
                style="display: none"
              />
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isCreateMode}">
              <span style="font-size: 0.82rem; color: #64748b"
                >先に従業員情報を保存してください。保存後に画像アップロードできます。</span
              >
            </apex:outputPanel>
          </div>
        </div>
      </div>
    </div>
  </apex:form>

  <script>
    function openAvatarModal() {
      var modal = document.getElementById("avatarModal");
      if (modal) {
        modal.classList.add("open");
      }
    }

    function closeAvatarModal(event) {
      if (event && event.target && event.target.id !== "avatarModal") {
        return;
      }

      var modal = document.getElementById("avatarModal");
      if (modal) {
        modal.classList.remove("open");
      }
    }

    function setTab(tabName) {
      var activeTabInputs = [
        document.getElementById("{!$Component.detailsForm.activeTab}"),
        document.getElementById("{!$Component.avatarForm.activeTab}")
      ];

      activeTabInputs.forEach(function (activeTabInput) {
        if (activeTabInput) {
          activeTabInput.value = tabName;
        }
      });

      // Hide all panels
      document.querySelectorAll(".tab-panel").forEach(function (panel) {
        panel.classList.remove("active");
      });

      // Show selected panel
      var targetPanel = document.getElementById("tab-" + tabName);
      if (targetPanel) {
        targetPanel.classList.add("active");
      }

      // Update tab buttons
      document.querySelectorAll(".tab-item").forEach(function (btn) {
        btn.classList.remove("active");
      });
      event.target.classList.add("active");
    }

    function prepareCompressedAvatarUpload(event) {
      if (event) {
        event.preventDefault();
      }

      var fileInput = document.getElementById(
        "{!$Component.avatarForm.avatarInput}"
      );
      var base64Input = document.getElementById(
        "{!$Component.avatarForm.avatarCompressedBase64}"
      );
      var fileNameInput = document.getElementById(
        "{!$Component.avatarForm.avatarCompressedFileName}"
      );
      var hiddenBtn = document.getElementById(
        "{!$Component.avatarForm.hiddenUploadTrigger}"
      );

      if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        alert("アップロードする画像を選択してください。");
        return false;
      }

      var selectedFile = fileInput.files[0];
      var originalSize = (selectedFile.size / 1024).toFixed(2); // KB
      console.log(
        "Original file size: " +
          originalSize +
          " KB, Type: " +
          selectedFile.type
      );

      if (!selectedFile.type || selectedFile.type.indexOf("image/") !== 0) {
        // Not an image, just submit as-is
        if (hiddenBtn) {
          hiddenBtn.click();
          return false;
        }
      }

      compressImageFile(selectedFile, 1280, 1280, 0.72)
        .then(function (result) {
          var compressedSize = (result.base64.length / 1.33 / 1024).toFixed(2); // Estimate actual size after base64
          console.log(
            "Compressed size (estimated): " +
              compressedSize +
              " KB, Ratio: " +
              ((compressedSize / originalSize) * 100).toFixed(1) +
              "%"
          );

          if (base64Input) {
            base64Input.value = result.base64;
          }
          if (fileNameInput) {
            fileNameInput.value = result.fileName;
          }
          if (hiddenBtn) {
            hiddenBtn.click();
          }
        })
        .catch(function (error) {
          console.error("Image compression failed:", error);
          if (base64Input) {
            base64Input.value = "";
          }
          if (fileNameInput) {
            fileNameInput.value = "";
          }
          if (hiddenBtn) {
            hiddenBtn.click();
          }
        });

      return false;
    }

    function compressImageFile(file, maxWidth, maxHeight, quality) {
      return new Promise(function (resolve, reject) {
        var reader = new FileReader();
        reader.onload = function (loadEvent) {
          var img = new Image();
          img.onload = function () {
            var width = img.width;
            var height = img.height;
            var scale = Math.min(maxWidth / width, maxHeight / height, 1);
            var targetWidth = Math.max(1, Math.round(width * scale));
            var targetHeight = Math.max(1, Math.round(height * scale));

            var canvas = document.createElement("canvas");
            canvas.width = targetWidth;
            canvas.height = targetHeight;

            var ctx = canvas.getContext("2d");
            if (!ctx) {
              reject(new Error("Canvas context unavailable"));
              return;
            }

            ctx.drawImage(img, 0, 0, targetWidth, targetHeight);
            var compressedDataUrl = canvas.toDataURL("image/jpeg", quality);
            var safeName =
              (file.name || "avatar").replace(/\.[^.]+$/, "") + ".jpg";

            resolve({
              base64: compressedDataUrl,
              fileName: safeName
            });
          };

          img.onerror = function () {
            reject(new Error("Invalid image"));
          };

          img.src = loadEvent.target.result;
        };

        reader.onerror = function () {
          reject(new Error("Failed to read file"));
        };

        reader.readAsDataURL(file);
      });
    }
  </script>
</apex:page>