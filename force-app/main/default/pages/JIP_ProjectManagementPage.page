<apex:page controller="JIP_ProjectManagementController" lightningStylesheets="true" docType="html-5.0" showHeader="false">
    <apex:slds />

    <style>
        :root {
            --primary: #0176d3;
            --primary-dark: #014486;
            --danger: #ea001e;
            --danger-dark: #ba0517;
            --success: #2e844a;
            --bg: #f3f3f3;
            --white: #ffffff;
            --text: #181818;
            --text-light: #444444;
            --border: #dddbda;
            --shadow: 0 2px 8px rgba(0,0,0,0.10);
            --teal: #0b827c;
            --teal-dark: #056764;
        }
        .jipa-container {
            max-width: 1300px;
            margin: 2rem auto;
            font-family: 'Salesforce Sans', 'Meiryo', 'Yu Gothic', sans-serif;
            background: var(--bg);
            min-height: 80vh;
        }
        .jipa-header {
            background: linear-gradient(135deg, #0b827c, #032d60);
            color: var(--white);
            padding: 1.5rem 2rem;
            border-radius: 8px 8px 0 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .jipa-header h1 { font-size: 1.5rem; margin: 0; font-weight: 700; }
        .jipa-header .subtitle { font-size: 0.9rem; opacity: 0.85; margin-top: 0.25rem; }
        .jipa-body {
            padding: 1.5rem 2rem 2rem;
            background: var(--white);
            border-radius: 0 0 8px 8px;
            box-shadow: var(--shadow);
        }
        .jipa-toolbar {
            display: flex; align-items: center; gap: 0.75rem;
            margin-bottom: 1.25rem; flex-wrap: wrap;
        }
        .jipa-toolbar input[type="text"] {
            padding: 0.5rem 0.85rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.95rem; width: 260px; outline: none;
        }
        .jipa-toolbar input[type="text"]:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.15);
        }
        .jipa-toolbar select {
            padding: 0.5rem 0.65rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.9rem; outline: none;
        }
        .jipa-toolbar select:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.15);
        }
        .btn {
            padding: 0.5rem 1.2rem; border: none; border-radius: 6px;
            font-size: 0.92rem; cursor: pointer; font-weight: 600;
            transition: background 0.15s; display: inline-flex; align-items: center; gap: 0.35rem;
        }
        .btn-primary { background: var(--primary); color: var(--white); }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-secondary { background: #e5e5e5; color: var(--text); }
        .btn-secondary:hover { background: #d4d4d4; }
        .btn-danger { background: var(--danger); color: var(--white); }
        .btn-danger:hover { background: var(--danger-dark); }
        .btn-success { background: var(--success); color: var(--white); }
        .btn-success:hover { background: #236b3b; }
        .btn-sm { padding: 0.32rem 0.75rem; font-size: 0.84rem; }
        .btn-new { margin-left: auto; }

        /* Table */
        .jipa-table-wrap { overflow-x: auto; }
        .jipa-table {
            width: 100%; border-collapse: separate; border-spacing: 0;
            border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
            min-width: 950px;
        }
        .jipa-table thead th {
            background: #f7f7f7; color: var(--text); font-weight: 700;
            padding: 0.65rem 0.75rem; text-align: left; font-size: 0.85rem;
            border-bottom: 2px solid var(--border); white-space: nowrap;
        }
        .jipa-table tbody td {
            padding: 0.55rem 0.75rem; border-bottom: 1px solid #f0f0f0;
            font-size: 0.88rem; color: var(--text-light); white-space: nowrap;
        }
        .jipa-table tbody tr:hover { background: #f0f7ff; }
        .jipa-table tbody tr:last-child td { border-bottom: none; }
        .jipa-table .actions { display: flex; gap: 0.35rem; }
        .jipa-empty { text-align: center; color: #999; padding: 2.5rem 0; font-size: 1.05rem; }
        .jipa-count { color: var(--text-light); font-size: 0.88rem; margin-bottom: 0.6rem; }

        /* Status badges */
        .badge {
            padding: 0.2rem 0.55rem; border-radius: 10px; font-size: 0.78rem;
            font-weight: 600; display: inline-block;
        }
        .badge-new { background: #eef4ff; color: #0176d3; }
        .badge-active { background: #e6f9ed; color: #2e844a; }
        .badge-completed { background: #e8daff; color: #9050e9; }
        .badge-onhold { background: #fff3cd; color: #856404; }

        /* Progress bar */
        .progress-wrap {
            display: flex; align-items: center; gap: 0.5rem;
        }
        .progress-bar {
            flex: 1; height: 6px; background: #e5e5e5; border-radius: 3px; overflow: hidden;
        }
        .progress-fill {
            height: 100%; border-radius: 3px; transition: width 0.3s;
        }
        .progress-fill.on-track { background: var(--success); }
        .progress-fill.overdue { background: var(--danger); }
        .progress-fill.not-started { background: #999; }

        /* Modal */
        .jipa-modal-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.45); z-index: 9000;
            display: flex; align-items: flex-start; justify-content: center;
            padding-top: 5vh; overflow-y: auto;
        }
        .jipa-modal {
            background: var(--white); border-radius: 10px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
            width: 680px; max-width: 95vw;
            margin-bottom: 3vh;
            animation: fadeInModal 0.18s;
        }
        @keyframes fadeInModal {
            from { opacity: 0; transform: translateY(-16px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .jipa-modal-header {
            background: linear-gradient(135deg, #0b827c, #032d60);
            color: var(--white); padding: 1.1rem 1.5rem;
            border-radius: 10px 10px 0 0; font-size: 1.12rem; font-weight: 700;
        }
        .jipa-modal-body { padding: 1.2rem 1.5rem 0.5rem; }
        .section-title {
            font-size: 0.95rem; font-weight: 700; color: var(--teal);
            border-bottom: 2px solid var(--teal); padding-bottom: 0.35rem;
            margin: 1.2rem 0 0.8rem; display: flex; align-items: center; gap: 0.4rem;
        }
        .section-title:first-child { margin-top: 0; }
        .form-row { display: flex; gap: 1rem; margin-bottom: 0.85rem; }
        .form-group { flex: 1; min-width: 0; }
        .form-group label {
            display: block; font-weight: 600; margin-bottom: 0.25rem;
            color: var(--text); font-size: 0.88rem;
        }
        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="tel"],
        .form-group input[type="date"],
        .form-group input[type="number"],
        .form-group select,
        .form-group textarea {
            width: 100%; padding: 0.45rem 0.65rem; border: 1px solid var(--border);
            border-radius: 6px; font-size: 0.9rem; box-sizing: border-box; outline: none;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--primary); box-shadow: 0 0 0 2px rgba(1,118,211,0.12);
        }
        .form-group textarea { resize: vertical; min-height: 60px; }
        .required-mark { color: #ea001e; }
        .jipa-modal-footer {
            display: flex; justify-content: flex-end; gap: 0.6rem;
            padding: 1rem 1.5rem; border-top: 1px solid var(--border);
        }
        .jipa-messages { margin-bottom: 1rem; }
        .filter-label { font-size: 0.82rem; color: var(--text-light); font-weight: 600; }

        /* Summary Cards */
        .summary-cards {
            display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;
        }
        .summary-card {
            flex: 1; min-width: 140px; padding: 1rem 1.2rem;
            border-radius: 8px; text-align: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }
        .summary-card .card-number {
            font-size: 1.8rem; font-weight: 800; line-height: 1;
        }
        .summary-card .card-label {
            font-size: 0.82rem; font-weight: 600; margin-top: 0.3rem;
        }
        .card-total { background: #f0f7ff; }
        .card-total .card-number { color: #0176d3; }
        .card-total .card-label { color: #014486; }
        .card-active { background: #e6f9ed; }
        .card-active .card-number { color: #2e844a; }
        .card-active .card-label { color: #155724; }
        .card-completed { background: #e8daff; }
        .card-completed .card-number { color: #9050e9; }
        .card-completed .card-label { color: #6b3fa0; }
        .card-onhold { background: #fff3cd; }
        .card-onhold .card-number { color: #856404; }
        .card-onhold .card-label { color: #6c5100; }
    </style>

    <apex:form id="mainForm">
        <div class="jipa-container">
            <!-- Header -->
            <div class="jipa-header">
                <div>
                    <h1>&#128188; プロジェクト管理システム</h1>
                    <div class="subtitle">Project Management - プロジェクトの一覧・登録・編集・削除</div>
                </div>
            </div>

            <div class="jipa-body">
                <!-- Messages -->
                <div class="jipa-messages">
                    <apex:messages id="pageMessages" layout="list" />
                </div>

                <!-- Summary Cards -->
                <div class="summary-cards">
                    <div class="summary-card card-total">
                        <div class="card-number">{!projects.size}</div>
                        <div class="card-label">全プロジェクト</div>
                    </div>
                    <apex:variable var="activeCount" value="{!0}" />
                    <apex:variable var="completedCount" value="{!0}" />
                    <apex:variable var="onholdCount" value="{!0}" />
                    <apex:repeat value="{!projects}" var="p">
                        <apex:variable var="activeCount" value="{!IF(p.Status__c == 'Active', activeCount + 1, activeCount)}" />
                        <apex:variable var="completedCount" value="{!IF(p.Status__c == 'Completed', completedCount + 1, completedCount)}" />
                        <apex:variable var="onholdCount" value="{!IF(p.Status__c == 'On Hold', onholdCount + 1, onholdCount)}" />
                    </apex:repeat>
                    <div class="summary-card card-active">
                        <div class="card-number">{!activeCount}</div>
                        <div class="card-label">進行中 (Active)</div>
                    </div>
                    <div class="summary-card card-completed">
                        <div class="card-number">{!completedCount}</div>
                        <div class="card-label">完了 (Completed)</div>
                    </div>
                    <div class="summary-card card-onhold">
                        <div class="card-number">{!onholdCount}</div>
                        <div class="card-label">保留中 (On Hold)</div>
                    </div>
                </div>

                <!-- Toolbar -->
                <div class="jipa-toolbar">
                    <apex:inputText value="{!searchKeyword}" html-placeholder="プロジェクト名・技術スタック・クライアントで検索..." />
                    <span class="filter-label">ステータス:</span>
                    <apex:selectList value="{!filterStatus}" size="1">
                        <apex:selectOptions value="{!statusFilterOptions}" />
                    </apex:selectList>
                    <apex:commandButton value="&#128269; 検索" action="{!searchProjects}" reRender="mainForm" styleClass="btn btn-primary" />
                    <apex:commandButton value="クリア" action="{!clearSearch}" reRender="mainForm" styleClass="btn btn-secondary" />
                    <apex:commandButton value="&#10133; 新規登録" action="{!openNewModal}" reRender="mainForm" styleClass="btn btn-success btn-new" />
                </div>

                <!-- Count -->
                <div class="jipa-count">
                    検索結果: <strong>{!projects.size}</strong> 件
                </div>

                <!-- Data Table -->
                <apex:outputPanel rendered="{!projects.size > 0}">
                    <div class="jipa-table-wrap">
                        <table class="jipa-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>プロジェクト名</th>
                                    <th>クライアント</th>
                                    <th>マネージャー</th>
                                    <th>ステータス</th>
                                    <th>技術スタック</th>
                                    <th>開始日</th>
                                    <th>終了日</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <apex:variable var="rowNum" value="{!0}" />
                                <apex:repeat value="{!projects}" var="p">
                                    <apex:variable var="rowNum" value="{!rowNum + 1}" />
                                    <tr>
                                        <td>{!rowNum}</td>
                                        <td><strong>{!p.Name__c}</strong></td>
                                        <td>{!p.ClientCompany__r.Name}</td>
                                        <td>{!p.Manager__r.Name}</td>
                                        <td>
                                            <apex:outputPanel rendered="{!p.Status__c == 'New'}">
                                                <span class="badge badge-new">New</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!p.Status__c == 'Active'}">
                                                <span class="badge badge-active">Active</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!p.Status__c == 'Completed'}">
                                                <span class="badge badge-completed">Completed</span>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!p.Status__c == 'On Hold'}">
                                                <span class="badge badge-onhold">On Hold</span>
                                            </apex:outputPanel>
                                        </td>
                                        <td>{!p.TechStack__c}</td>
                                        <td>
                                            <apex:outputText value="{0,date,yyyy/MM/dd}">
                                                <apex:param value="{!p.StartDate__c}" />
                                            </apex:outputText>
                                        </td>
                                        <td>
                                            <apex:outputText value="{0,date,yyyy/MM/dd}">
                                                <apex:param value="{!p.EndDate__c}" />
                                            </apex:outputText>
                                        </td>
                                        <td class="actions">
                                            <apex:commandButton value="&#9998; 編集" action="{!openEditModal}" reRender="mainForm" styleClass="btn btn-primary btn-sm">
                                                <apex:param name="editId" value="{!p.Id}" assignTo="{!currentProject}" />
                                            </apex:commandButton>
                                            <apex:commandButton value="&#128465; 削除" action="{!deleteProject}" reRender="mainForm" styleClass="btn btn-danger btn-sm"
                                                onclick="if(!confirm('このプロジェクトを削除してもよろしいですか？')){return false;}">
                                                <apex:param name="deleteId" value="{!p.Id}" assignTo="{!deleteProjectId}" />
                                            </apex:commandButton>
                                        </td>
                                    </tr>
                                </apex:repeat>
                            </tbody>
                        </table>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!projects.size == 0}">
                    <div class="jipa-empty">
                        プロジェクトデータがありません。「新規登録」ボタンからプロジェクトを追加してください。
                    </div>
                </apex:outputPanel>
            </div>
        </div>

        <!-- Modal: New / Edit -->
        <apex:outputPanel rendered="{!showModal}">
            <div class="jipa-modal-overlay">
                <div class="jipa-modal">
                    <div class="jipa-modal-header">
                        <apex:outputPanel rendered="{!!isEditMode}">&#10133; 新規プロジェクト登録</apex:outputPanel>
                        <apex:outputPanel rendered="{!isEditMode}">&#9998; プロジェクト情報編集</apex:outputPanel>
                    </div>
                    <div class="jipa-modal-body">

                        <!-- Section: 基本情報 -->
                        <div class="section-title">&#128203; 基本情報</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>プロジェクト名 <span class="required-mark">*</span></label>
                                <apex:inputText value="{!currentProject.Name__c}" html-placeholder="例: Webシステム開発" />
                            </div>
                            <div class="form-group">
                                <label>ステータス <span class="required-mark">*</span></label>
                                <apex:inputField value="{!currentProject.Status__c}" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>クライアント企業</label>
                                <apex:inputField value="{!currentProject.ClientCompany__c}" />
                            </div>
                            <div class="form-group">
                                <label>マネージャー</label>
                                <apex:inputField value="{!currentProject.Manager__c}" />
                            </div>
                        </div>

                        <!-- Section: スケジュール -->
                        <div class="section-title">&#128197; スケジュール</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>開始日</label>
                                <apex:inputField value="{!currentProject.StartDate__c}" />
                            </div>
                            <div class="form-group">
                                <label>終了日</label>
                                <apex:inputField value="{!currentProject.EndDate__c}" />
                            </div>
                        </div>

                        <!-- Section: 技術情報 -->
                        <div class="section-title">&#128296; 技術情報</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>技術スタック</label>
                                <apex:inputText value="{!currentProject.TechStack__c}" html-placeholder="例: Java, Spring Boot, React, PostgreSQL" />
                            </div>
                        </div>

                    </div>
                    <div class="jipa-modal-footer">
                        <apex:commandButton value="キャンセル" action="{!closeModal}" reRender="mainForm" styleClass="btn btn-secondary" />
                        <apex:commandButton value="{!IF(isEditMode, '&#9998; 更新する', '&#10133; 登録する')}" action="{!saveProject}" reRender="mainForm" styleClass="btn btn-primary" />
                    </div>
                </div>
            </div>
        </apex:outputPanel>
    </apex:form>
</apex:page>